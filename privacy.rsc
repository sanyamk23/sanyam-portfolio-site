13:["$","p",null,{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"The fonts are served from this site, so your browser doesn't contact Google to load them. The LinkedIn and GitHub links take you to those sites, which have their own policies. Nothing from them loads on this site."}]
