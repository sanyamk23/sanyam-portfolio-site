17:["$","ul",null,{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 text-lg leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"The Work with me form: you asked me to look at your project, so I use your details to reply and to set up any work that follows. Answering people who write to me is also a legitimate interest."}]]}],["$","li","1",{"className":"flex gap-3 text-lg leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Emails you send me: you wrote to me, so I reply."}]]}],["$","li","2",{"className":"flex gap-3 text-lg leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Anything else you choose to share: your consent. You can take it back whenever you like."}]]}]]}]
