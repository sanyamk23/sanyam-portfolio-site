1b:["$","p",null,{"className":"mt-5 text-lg leading-[1.75] text-ink","children":["Email ",["$","a",null,{"href":"mailto:sanyamkumat2305@gmail.com","className":"text-accent underline underline-offset-4 hover:text-accent-soft","children":"sanyamkumat2305@gmail.com"}]," and ask me to show you what I have about you, correct it, delete it, or stop emailing you. I'll answer within 30 days."]}]
1c:["$","p",null,{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"If you're in the EU or UK and think I've mishandled your information, you can complain to your local data protection authority."}]
