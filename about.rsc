a:[["$","header",null,{"className":"head pad","children":[["$","canvas",null,{"className":"head-code","id":"head-code","aria-hidden":"true"}],["$","div",null,{"className":"head-grid split","children":[["$","div",null,{"className":"head-text","children":[null,["$","h1",null,{"className":"head-title","data-head":true,"aria-label":"I'm Sanyam. I build and ship apps with AI.","children":[["$","span","0",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"I'm"}]," "]}],["$","span","1",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"Sanyam."}]," "]}],["$","span","2",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"I"}]," "]}],["$","span","3",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"build"}]," "]}],["$","span","4",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"and"}]," "]}],["$","span","5",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"ship"}]," "]}],["$","span","6",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"apps"}]," "]}],["$","span","7",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"with"}]," "]}],["$","span","8",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"AI."}],null]}]]}],null]}],["$","span",null,{"className":"cover portrait","children":[["$","img",null,{"src":"/me/paris-portrait-900.webp","width":900,"height":1200,"alt":"Portrait of Sanyam Kumat","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}]]}]]}],["$","div",null,{"className":"sheet","children":[["$","canvas",null,{"className":"seam","data-seam":"#F5F2EA","aria-hidden":"true"}],["$","div",null,{"className":"pad sheet-in","children":["$","div",null,{"className":"read","children":[["$","div",null,{"className":"space-y-5 text-lg leading-[1.7] text-ink-soft","children":[["$","p",null,{"children":"I'm Sanyam Kumat, a backend and cloud engineer based in Jaipur, Rajasthan. I design, deploy, and optimize cloud-native applications — Python, FastAPI/Django, AWS, Kubernetes, and Terraform — with a focus on reliability, performance, and cost."}],["$","p",null,{"children":"At SkillBrew.AI I work across the backend and the cloud: production FastAPI services next to a Django monolith, workloads moved to EKS with Helm, RAG agents on Google ADK, Grafana dashboards on Prometheus, and Terraform-driven CI/CD. Recent work includes an admin-created organizations flow, Claude-based PR review across our repos, and a latency and cost audit of a voice agent. Earlier at Brudite I built REST APIs with Django REST Framework and JWT, and tuned PostgreSQL on AWS."}],["$","p",null,{"children":"Outside work I contribute to open source, with open pull requests on aws-cdk for Cognito domain prefix validation, a CodeBuild service role override and a clearer Lambda storage error. I also write about what I learn, like how we cut RAG chunks by 67% while answer accuracy went up 30%. If you want something built, or want to work together, the questionnaire is where that starts."}]]}],["$","dl",null,{"className":"facts","children":[["$","div","Public repos",{"children":[["$","dt",null,{"className":"sr-only","children":"Public repos"}],["$","dd",null,{"children":"56"}],["$","dd",null,{"children":"Public repos"}]]}],["$","div","Experience",{"children":[["$","dt",null,{"className":"sr-only","children":"Experience"}],["$","dd",null,{"children":"2.5+ yrs"}],["$","dd",null,{"children":"Experience"}]]}],["$","div","Certifications",{"children":[["$","dt",null,{"className":"sr-only","children":"Certifications"}],["$","dd",null,{"children":"6"}],["$","dd",null,{"children":"Certifications"}]]}]]}]]}]}]]}],["$","section",null,{"id":"ask","className":"band pad","children":[["$","canvas",null,{"className":"seam","data-seam":"#2b57c8","aria-hidden":"true"}],["$","canvas",null,{"className":"as