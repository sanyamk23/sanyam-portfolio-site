11:{"metadata":[["$","title","0",{"children":"10/10 signs your website is AI slop, and the prompt rules that fix it — Sanyam Kumat"}],["$","meta","1",{"name":"description","content":"The slate-900 hero with the purple blob, the Lucide icon in a badge, the glowing Most Popular card, Sarah, Head of Growth. Every tell from the video, why Claude keeps producing it, and the exact UI rules I feed it so it stops."}],["$","meta","2",{"property":"og:title","content":"Sanyam Kumat"}],["$","meta","3",{"property":"og:description","content":"I build scalable cloud-native backends, APIs, and AI-powered systems."}],["$","meta","4",{"property":"og:image","content":"https://sanyam-portfolio-site.onrender.com/og.jpg"}],["$","meta","5",{"property":"og:image:width","content":"1200"}],["$","meta","6",{"property":"og:image:height","content":"630"}],["$","meta","7",{"property":"og:type","content":"website"}],["$","meta","8",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","9",{"name":"twitter:title","content":"Sanyam Kumat"}],["$","meta","10",{"name":"twitter:description","content":"I build scalable cloud-native backends, APIs, and AI-powered systems."}],["$","meta","11",{"name":"twitter:image","content":"https://sanyam-portfolio-site.onrender.com/og.jpg"}],["$","meta","12",{"name":"twitter:image:width","content":"1200"}],["$","meta","13",{"name":"twitter:image:height","content":"630"}],["$","link","14",{"rel":"icon","href":"/icon-m.svg","type":"image/svg+xml"}],["$","link","15",{"rel":"icon","href":"/favicon.ico","sizes":"48x48"}],["$","link","16",{"rel":"apple-touch-icon","href":"/apple-touch-icon.png"}],["$","$L34","17",{}]],"error":null,"digest":"$undefined"}
