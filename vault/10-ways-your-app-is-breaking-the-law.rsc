d:[["$","header",null,{"className":"head pad","children":[["$","canvas",null,{"className":"head-code","id":"head-code","aria-hidden":"true"}],["$","div",null,{"className":"head-grid split","children":[["$","div",null,{"className":"head-text","children":[["$","div",null,{"className":"head-meta","children":[["$","$L8",null,{"href":"/vault","aria-label":"Back to the Vault","children":"← /vault"}],["$","span",null,{"children":"Shipping"}],["$","span",null,{"children":["8 min"," read"]}]]}],["$","h1",null,{"className":"head-title","data-head":true,"aria-label":"10 ways your app is breaking the law (2026 edition)","children":[["$","span","0",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"10"}]," "]}],["$","span","1",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"ways"}]," "]}],["$","span","2",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"your"}]," "]}],["$","span","3",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"app"}]," "]}],["$","span","4",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"is"}]," "]}],["$","span","5",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"breaking"}]," "]}],["$","span","6",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"the"}]," "]}],["$","span","7",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"law"}]," "]}],["$","span","8",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"(2026"}]," "]}],["$","span","9",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"edition)"}],null]}]]}],["$","$L7",null,{"onMount":true,"delay":0.2,"y":12,"children":[["$","p",null,{"className":"head-lede","children":"The sued list needed somebody to hire a lawyer. These don't. Ten laws with a regulator, a fine schedule, and in three cases a portal where a stranger reports you, oldest first, plus one more that switched on today."}],null]}]]}],["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/10-ways-your-app-is-breaking-the-law.webp","width":1200,"height":800,"alt":"","fetchPriority":"high","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}]]}]]}],["$","div",null,{"className":"sheet","children":[["$","canvas",null,{"className":"seam","data-seam":"#F5F2EA","aria-hidden":"true"}],["$","div",null,{"className":"pad sheet-in","children":[["$","article",null,{"className":"read guide","children":["$","div",null,{"children":[["$","div","0",{"className":"mt-6 rounded-xl border border-accent/30 bg-accent/10 px-5 py-4 leading-[1.7] text-ink","children":"I'm not a lawyer. This is a checklist, not legal advice. If your app takes money or personal data, pay someone with a license to look at it."}],["$","p","1",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"The sued list needed somebody to hire a lawyer. These don't. Every one of them has a regulator and a form, and three of them have a portal where a stranger can report you."}],["$","p","2",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Ordered by the date the law went live, oldest first, because the newest ones are the ones your AI has never heard of. Half this list did not exist when its training data stopped."}],["$","div","3",{"className":"mt-6 rounded-xl border border-accent/30 bg-accent/10 px-5 py-4 leading-[1.7] text-ink","children":"Add it up, one violation of each at the cheapest number in every range: $72,338 in flat fines, plus 33% of your worldwide revenue from the percentage ones. 35.5% with the closer."}],["$","h2","4",{"className":"mt-12 t-h3 text-ink","children":"1. Stock image with no license"}],["$","p","5",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"You asked the AI for a landing page and it dropped in a \"placeholder\" hero image that is somebody's Getty or Shutterstock photo. Or you grabbed one off Google Images at 2am. Nobody has to notice you: reverse-image bots, Pixsy and Getty's own, crawl the web and mail four-figure demand letters at whatever they match."}],["$","p","6",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"$$750 to $30,000 per image, up to $150,000 if a court calls it willful. That's 17 U.S.C. 504(c) statutory damages, and it's per image, not per site. Law: 1976."}],"$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e","$L4f","$L50","$L51","$L52","$L53","$L54","$L55","$L56","$L57","$L58","$L59"]}]}],"$L5a"]}]]}],"$L5b"]
5c:I[6502,["619","static/chunks/619-ba102abea3e3d0e4.js","506","static/chunks/506-51bde6540850d248.js","867","static/chunks/app/vault/%5Bslug%5D/page-cbc8dd1a06312276.js"],"CopyButton"]
17:["$","p","7",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: every image in /public has a license file next to it or a link to where it came from. Unsplash, Pexels, your own camera. Delete anything you can't source. Ten minutes."}]
18:["$","h2","8",{"className":"mt-12 t-h3 text-ink","children":"2. Cookie banner with no reject button"}]
19:["$","p","9",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"You installed a cookie banner component with \"Accept all\" as the only button, or Accept in a big button and \"Manage preferences\" in grey text three clicks deep. The non-essential cookies fire either way."}]
1a:["$","p","10",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Up to €20,000,000 or 4% of worldwide revenue, whichever is higher. On January 6, 2022, France's CNIL fined Google €150 million and Facebook €60 million for exactly this: refusing was harder than accepting. Law: 2018."}]
1b:["$","p","11",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: reject is the same size and the same number of clicks as accept. Nothing non-essential loads until someone clicks accept. Test it in a private window with the Network tab open."}]
1c:["$","h2","12",{"className":"mt-12 t-h3 text-ink","children":"3. Posts with no report button"}]
1d:["$","p","13",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"You shipped comments, posts, reviews or uploads with no way for a user to flag something as illegal, no contact point, and terms that don't say how moderation works. The DSA applies to non-EU companies the moment one EU user signs up."}]
1e:["$","p","14",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Up to 6% of global turnover. Article 16 of the Digital Services Act requires a notice and action mechanism on every piece of user content, and it has been in force for everyone, not just the big platforms, since February 17, 2024."}]
1f:["$","p","15",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: a Report button on every piece of user content that goes to a queue you actually read, an email address on a /legal page as the point of contact, and one paragraph in the terms on what gets removed and how to appeal."}]
20:["$","h2","16",{"className":"mt-12 t-h3 text-ink","children":"4. Health fields sent to analytics"}]
21:["$","p","17",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Your app has a symptom field, a mood log, a period tracker, a \"fitness goal\" tag or precise location, and the analytics SDK ships every event including those. Mixpanel, the Meta pixel, GA4, PostHog. Washington's definition of consumer health data covers anything that reveals health status, including location near a clinic."}]
22:["$","p","18",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Up to $7,500 per violation from the attorney general, and My Health My Data has a private right of action, so users sue you directly for actual damages, trebled, with fees. The first class action, Maxwell v. Amazon, was filed February 10, 2025, over an SDK harvesting location inside other people's apps. Law: March 31, 2024."}]
23:["$","p","19",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: an allowlist of event properties that may leave the app, so anything health-shaped is stripped before the SDK sees it. A separate consent screen before you collect a health field at all. A published consumer health data policy."}]
24:["$","h2","20",{"className":"mt-12 t-h3 text-ink","children":"5. User posts, no risk assessment"}]
25:["$","p","21",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Any service where users can post to other users, with UK users on it, and no written illegal-content risk assessment sitting in a folder. Ofcom asks for it and you have nothing to send."}]
26:["$","p","22",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Up to £18,000,000 or 10% of qualifying worldwide revenue, whichever is greater. The first Ofcom fine under the Online Safety Act landed on October 13, 2025: 4chan, £20,000 plus £100 a day for not replying. Law: March 17, 2025."}]
27:["$","p","23",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: write the risk assessment. Ofcom publishes a template for small services. Keep it with your legal docs, and make sure the report button from item 3 exists so the assessment isn't fiction."}]
28:["$","h2","24",{"className":"mt-12 t-h3 text-ink","children":"6. Countdown timer that resets"}]
29:["$","p","25",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"You pasted in an \"Offer ends in 09:59\" component that restarts on refresh, an \"only 3 spots left\" that is a hard-coded string, or a \"12 people are viewing this\" widget fed by Math.random()."}]
2a:["$","p","26",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Up to 10% of global turnover, imposed by the CMA directly, no court. They opened their first eight investigations under the new powers this year. The FTC treats the same thing as deceptive in the US. The UK just put a bigger number on it. Law: April 6, 2025."}]
2b:["$","p","27",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: every urgency number reads a real value out of the database with a real end time. Delete the ones that can't."}]
2c:["$","h2","28",{"className":"mt-12 t-h3 text-ink","children":"7. Chatbot doing therapy"}]
2d:["$","p","29",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"The system prompt says \"you are a warm, supportive therapist,\" the landing page says \"AI therapy for $9 a month,\" and no licensed human is anywhere in the loop."}]
2e:["$","p","30",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Up to $10,000 per violation. Illinois HB 1806 banned offering therapy or psychotherapy through AI to the public unless a licensed professional conducts it, and the ban names \"individual, corporation or entity,\" so being one guy doesn't exempt you. Law: August 1, 2025."}]
2f:["$","p","31",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: the words therapy, therapist, counseling and treatment come out of the prompt and the marketing. Call it journaling or coaching and mean it. Block Illinois or put a licensed clinician in the loop. Keep the self-harm protocol from the sued list."}]
30:["$","h2","32",{"className":"mt-12 t-h3 text-ink","children":"8. User-data pricing, no label"}]
31:["$","p","33",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"You built \"smart pricing\" or a \"personalised discount\" where the price someone sees depends on their history, their device or their location."}]
32:["$","p","34",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Up to $1,000 per violation, no cap, no proof of harm. New York requires the exact sentence THIS PRICE WAS SET BY AN ALGORITHM USING YOUR PERSONAL DATA next to that price. A retail trade group challenged the law and lost. Law: November 10, 2025."}]
33:["$","p","35",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: if price depends on any per-user signal, render the disclosure string beside it. Or make the price the same for everyone and key your discounts to codes instead."}]
34:["$","h2","36",{"className":"mt-12 t-h3 text-ink","children":"9. Uploads with no 48-hour takedown"}]
35:["$","p","37",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Image or video uploads, or an AI image generator, with a support email as the only way to complain."}]
36:["$","p","38",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Up to $53,088 per violation, off the same FTC penalty schedule at 16 CFR 1.98. The TAKE IT DOWN Act requires a clear notice-and-removal process for non-consensual intimate images, AI forgeries included, removal within 48 hours of a valid request, and removal of known copies. The FTC opened a public portal where anyone can report a platform that doesn't have one. Law: May 19, 2026."}]
37:["$","p","39",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: a /report-image route that takes a link, a signature and a statement of non-consent, writes a ticket with a 48-hour SLA, and hashes the file so re-uploads are blocked. Half a day."}]
38:["$","h2","40",{"className":"mt-12 t-h3 text-ink","children":"10. AI output with no AI label"}]
39:["$","p","41",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"A chat feature that never says it's AI. An image or voice generator whose files carry no machine-readable AI mark. A \"hear it in your own voice\" feature with no deepfake label."}]
3a:["$","p","42",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Up to €15,000,000 or 3% of worldwide turnover, whichever is higher. Article 50 of the EU AI Act went live five weeks ago and the Digital Omnibus did not delay it. The only grace left is until December 2, 2026, for machine-readable marking on systems that were already on the market before August 2. Law: August 2, 2026."}]
3b:["$","p","43",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: a persistent \"you're talking to an AI\" line in the chat UI, C2PA or equivalent metadata on every generated file, and a visible AI-generated label on anything that shows a real person."}]
3c:["$","h2","44",{"className":"mt-12 t-h3 text-ink","children":"11. No 24-hour exploit report"}]
3d:["$","p","45",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"The closer, and it switches on today. You ship a mobile app or a downloadable client to EU users with no security contact, no vulnerability intake, and no way of knowing you're being exploited in the first place."}]
3e:["$","p","46",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Up to €15,000,000 or 2.5% of worldwide turnover. From today, manufacturers of products with digital elements get 24 hours from learning of an actively exploited vulnerability to file an early warning with ENISA, 72 hours for the full notice, 14 days for the final report. Pure SaaS is mostly outside the Cyber Resilience Act. An app in the stores is inside it. Law: September 11, 2026."}]
3f:["$","p","47",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: a security.txt with an address someone reads, error monitoring that pages you, dependency alerts on, and a one-page runbook that says who files the ENISA report and where the portal is."}]
40:["$","div","48",{"className":"mt-6 rounded-xl border border-accent/30 bg-accent/10 px-5 py-4 leading-[1.7] text-ink","children":"Add it up, one violation of each at the cheapest number in every range: $72,338 in flat fines, plus 33% of your worldwide revenue from the percentage ones. 35.5% with the closer."}]
41:["$","p","49",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"The sued list needed a plaintiff. These have a portal, so run the audit below before a stranger runs it on you."}]
42:["$","h2","50",{"className":"mt-12 t-h3 text-ink","children":"Paste this into Claude"}]
