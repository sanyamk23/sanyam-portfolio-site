1d:["$","h2","13",{"className":"mt-12 t-h3 text-ink","children":"3. Obsidian"}]
1e:["$","p","14",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Your AI second brain. Obsidian is a free notes app where everything is plain markdown hosted locally on your own PC, so you own it forever. Create a vault, connect Claude, and it starts building connections between your ideas that you never would have made yourself."}]
1f:["$","p","15",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"On its own it's a great note-taker. Point an AI at the vault and months of scattered notes turn into a knowledge base you can query, one that surfaces patterns, contradictions, and links across everything you've ever saved."}]
20:["$","p","16",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Use it for:"}]
21:["$","ul","17",{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"A private knowledge base that compounds every day."}]]}],["$","li","1",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Connecting research, call notes, and ideas into one map you can actually search."}]]}],["$","li","2",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Feeding an AI months of your own context so its answers sound like they know you."}]]}]]}]
22:["$","p","18",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"I wrote a full step-by-step setup for this exact workflow. It's in the Vault under the second brain guide."}]
23:["$","div","19",{"className":"mt-4","children":["$","a",null,{"href":"https://obsidian.md","target":"_blank","rel":"noopener noreferrer","className":"inline-flex w-fit items-center gap-1.5 rounded-xl border border-accent/40 bg-accent/10 px-5 py-2.5 text-sm font-semibold text-accent-soft transition-colors hover:bg-accent/20 hover:text-accent","children":["Get Obsidian"," ",["$","span",null,{"aria-hidden":true,"children":"↗"}]]}]}]
24:["$","h2","20",{"className":"mt-12 t-h3 text-ink","children":"4. Perplexity"}]
25:["$","p","21",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"The best research tool when you need real answers fast. Perplexity searches the web live and cites every source inline, so you skip the pile of results a normal search drowns you in. If you do any kind of professional research, you need this."}]
26:["$","p","22",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"It beats a chatbot for research because of the citations. Every answer comes with the receipts attached, so you can check it and quote it without opening a second tab."}]
27:["$","p","23",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Use it for:"}]
