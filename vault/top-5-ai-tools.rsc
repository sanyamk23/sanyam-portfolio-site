29:["$","div","25",{"className":"mt-4","children":["$","a",null,{"href":"https://www.perplexity.ai","target":"_blank","rel":"noopener noreferrer","className":"inline-flex w-fit items-center gap-1.5 rounded-xl border border-accent/40 bg-accent/10 px-5 py-2.5 text-sm font-semibold text-accent-soft transition-colors hover:bg-accent/20 hover:text-accent","children":["Get Perplexity"," ",["$","span",null,{"aria-hidden":true,"children":"↗"}]]}]}]
2a:["$","h2","26",{"className":"mt-12 t-h3 text-ink","children":"5. NotebookLM"}]
2b:["$","p","27",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Upload your research papers, reports, contracts, whatever you've got, and NotebookLM turns them into a fully interactive knowledge base. It's the best thinking partner out there because it basically cannot hallucinate. It only knows what you give it."}]
2c:["$","p","28",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"That constraint is the whole point. Every answer comes from your documents and points back to the exact passage, so nothing gets invented and your whole pile of material becomes instantly searchable."}]
2d:["$","p","29",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Use it for:"}]
2e:["$","ul","30",{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Grounded question-and-answer over your own documents with no made-up facts."}]]}],["$","li","1",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Summarizing dense reports, papers, or contracts in plain language."}]]}],["$","li","2",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Turning a pile of sources into a single notebook you can interrogate while you study or prep."}]]}]]}]
