"p","4",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"What the apps that make money have in common."}],["$","div","5",{"className":"mt-4","children":["$","a",null,{"href":"https://youtu.be/tK4NQtzfZbM","target":"_blank","rel":"noopener noreferrer","className":"inline-flex w-fit items-center gap-1.5 rounded-xl border border-accent/40 bg-accent/10 px-5 py-2.5 text-sm font-semibold text-accent-soft transition-colors hover:bg-accent/20 hover:text-accent","children":["3 · Vibe Coding Has A Security Problem (And How To Fix It)"," ","$L17"]}]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28"]}]}],"$L29"]}]]}],"$L2a"]
