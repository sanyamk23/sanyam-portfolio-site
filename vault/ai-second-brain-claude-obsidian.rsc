22:["$","p","18",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Second, ask your wiki questions once it has 10 or more articles. What patterns keep showing up across my customer calls? What did I decide last time I hit this problem? Where are the gaps in my strategy? Third, run a weekly health check to catch contradictions, orphan pages, and outdated claims before they compound:"}]
23:["$","div","19",{"className":"mt-5","children":[["$","div",null,{"className":"mb-2 flex items-center justify-between gap-4","children":[["$","span",null,{"className":"font-mono text-[12px] text-ink-dim","children":"Copy and paste"}],["$","$L2a",null,{"text":"claude -p \"Read every file in /wiki/. Find contradictions between pages, orphan pages\nwith no inbound links, concepts mentioned repeatedly with no dedicated page, and claims\nthat seem outdated based on newer files in /raw-sources/. Write a health report to\n/wiki/lint-report.md with specific fixes.\" --allowedTools Bash,Write,Read"}]]}],["$","pre",null,{"className":"rounded-xl bg-[#0a1020] p-5 font-mono text-[13px] leading-[1.7] text-[#e4e9f5] overflow-x-auto","children":["$","code",null,{"children":"claude -p \"Read every file in /wiki/. Find contradictions between pages, orphan pages\nwith no inbound links, concepts mentioned repeatedly with no dedicated page, and claims\nthat seem outdated based on newer files in /raw-sources/. Write a health report to\n/wiki/lint-report.md with specific fixes.\" --allowedTools Bash,Write,Read"}]}]]}]
24:["$","h2","20",{"className":"mt-12 t-h3 text-ink","children":"Step 6: Set up automations (optional)"}]
25:["$","p","21",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Set a morning briefing up once and it runs every day. After any meeting, drop the transcript in raw-sources/ and have Claude pull out every decision and action item, file the actions to an action tracker, log the decisions, and create a topic page linking back, so nothing gets lost in chat history again."}]
26:["$","h2","22",{"className":"mt-12 t-h3 text-ink","children":"Tips and tricks"}]
27:["$","ul","23",{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Obsidian Web Clipper converts any web article to markdown in one click. The fastest way to get sources in."}]]}],["$","li","1",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Graph View shows the shape of your wiki: which pages are hubs, which are orphans. Open it regularly."}]]}],["$","li","2",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Put your vault in a git repo. It's just markdown, so you get version history and backups for free."}]]}],["$","li","3",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Ingest one source at a time and stay involved. Read the summaries and steer what Claude emphasizes. You get better results than batch-dumping everything."}]]}],["$","li","4",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Save good answers back. When Claude gives you a great synthesis, file it as a new wiki page so your thinking compounds like your sources."}]]}]]}]
