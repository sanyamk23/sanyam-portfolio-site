a:[["$","header",null,{"className":"head pad","children":[["$","canvas",null,{"className":"head-code","id":"head-code","aria-hidden":"true"}],["$","div",null,{"className":"head-grid split","children":[["$","div",null,{"className":"head-text","children":[["$","div",null,{"className":"head-meta","children":[["$","$L8",null,{"href":"/vault","aria-label":"Back to the Vault","children":"← /vault"}],["$","span",null,{"children":"Tools"}],["$","span",null,{"children":["7 min"," read"]}]]}],["$","h1",null,{"className":"head-title","data-head":true,"aria-label":"The Stack: five tools that handle everything","children":[["$","span","0",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"The"}]," "]}],["$","span","1",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"Stack:"}]," "]}],["$","span","2",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"five"}]," "]}],["$","span","3",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"tools"}]," "]}],["$","span","4",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"that"}]," "]}],["$","span","5",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"handle"}]," "]}],["$","span","6",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"everything"}],null]}]]}],["$","$L7",null,{"onMount":true,"delay":0.2,"y":12,"children":[["$","p",null,{"className":"head-lede","children":"What to use for coding, hosting, backend, payments, and design when you're building an app by yourself, and what to skip."}],null]}]]}],["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/the-stack.webp","width":1200,"height":800,"alt":"","fetchPriority":"high","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}]]}]]}],["$","div",null,{"className":"sheet","children":[["$","canvas",null,{"className":"seam","data-seam":"#F5F2EA","aria-hidden":"true"}],["$","div",null,{"className":"pad sheet-in","children":[["$","article",null,{"className":"read guide","children":["$","div",null,{"children":[["$","p","0",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Every app you build needs the same five things: something to write the code, somewhere to put it, a place to store data, a way to take money, and a way to make it look like a real product."}],["$","p","1",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"You can burn a week researching each one. Or you can use the five below, which is what I use, and spend that week building instead."}],["$","div","2",{"className":"mt-7 overflow-x-auto rounded-xl border border-line bg-bg-soft/50","children":["$","table",null,{"className":"w-full min-w-[420px] border-collapse text-left","children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th","0",{"className":"border-b border-line-strong px-5 py-3.5 font-mono text-[12px] text-accent-soft","children":"Job"}],["$","th","1",{"className":"border-b border-line-strong px-5 py-3.5 font-mono text-[12px] text-accent-soft","children":"Use this"}],["$","th","2",{"className":"border-b border-line-strong px-5 py-3.5 font-mono text-[12px] text-accent-soft","children":"Skip"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"border-b border-line last:border-0","children":[["$","td","0",{"className":"px-5 py-3.5 text-[15px] leading-[1.6] text-ink","children":"Coding"}],["$","td","1",{"className":"px-5 py-3.5 text-[15px] font-semibold leading-[1.6] text-ink","children":"Claude Code"}],["$","td","2",{"className":"px-5 py-3.5 text-[15px] leading-[1.6] text-ink-dim line-through decoration-ink-dim/40","children":"Copilot"}]]}],["$","tr","1",{"className":"border-b border-line last:border-0","children":[["$","td","0",{"className":"px-5 py-3.5 text-[15px] leading-[1.6] text-ink","children":"Hosting"}],["$","td","1",{"className":"px-5 py-3.5 text-[15px] font-semibold leading-[1.6] text-ink","children":"Vercel"}],["$","td","2",{"className":"px-5 py-3.5 text-[15px] leading-[1.6] text-ink-dim line-through decoration-ink-dim/40","children":"GoDaddy"}]]}],["$","tr","2",{"className":"border-b border-line last:border-0","children":[["$","td","0",{"className":"px-5 py-3.5 text-[15px] leading-[1.6] text-ink","children":"Backend"}],["$","td","1",{"className":"px-5 py-3.5 text-[15px] font-semibold leading-[1.6] text-ink","children":"Supabase"}],"$L16"]}],"$L17","$L18"]}]]}]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46"]}]}],"$L47"]}]]}],"$L48"]
16:["$","td","2",{"className":"px-5 py-3.5 text-[15px] leading-[1.6] text-ink-dim line-through decoration-ink-dim/40","children":"AWS"}]
17:["$","tr","3",{"className":"border-b border-line last:border-0","children":[["$","td","0",{"className":"px-5 py-3.5 text-[15px] leading-[1.6] text-ink","children":"Payments"}],["$","td","1",{"className":"px-5 py-3.5 text-[15px] font-semibold leading-[1.6] text-ink","children":"Stripe"}],["$","td","2",{"className":"px-5 py-3.5 text-[15px] leading-[1.6] text-ink-dim line-through decoration-ink-dim/40","children":"PayPal"}]]}]
18:["$","tr","4",{"className":"border-b border-line last:border-0","children":[["$","td","0",{"className":"px-5 py-3.5 text-[15px] leading-[1.6] text-ink","children":"Design"}],["$","td","1",{"className":"px-5 py-3.5 text-[15px] font-semibold leading-[1.6] text-ink","children":"v0"}],["$","td","2",{"className":"px-5 py-3.5 text-[15px] leading-[1.6] text-ink-dim line-through decoration-ink-dim/40","children":"Canva"}]]}]
19:["$","h2","3",{"className":"mt-12 t-h3 text-ink","children":"Build in this order"}]
1a:["$","p","4",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Design the screens, generate the frontend, wire the database, add payments, deploy. Skipping ahead to payments before you have screens will waste your afternoon."}]
1b:["$","h2","5",{"className":"mt-12 t-h3 text-ink","children":"Coding: Claude Code"}]
1c:["$","p","6",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Claude Code runs in your terminal and edits your codebase directly. You describe a feature, it reads the relevant files, proposes a plan, then writes the code across however many files the change touches. It runs your tests, reads the errors, and fixes what it broke."}]
1d:["$","p","7",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Copilot completes the line you're typing, which helps when you already know what to type. Claude Code takes a task like \"add password reset with email verification\" and handles the route, the email template, the database column, and the error states."}]
1e:["$","p","8",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Cursor sits between them and it's a real option, especially if you want to see every diff before it lands. I moved off it because I stopped wanting to watch."}]
1f:["$","p","9",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Two settings that matter. Plan mode: hit Shift+Tab twice and Claude reads your code and writes a plan without touching a file. You approve it, then it builds. Use this for anything that spans more than two files. Read the plan like a contract and push back on the parts that look wrong, because fixing a plan costs you thirty seconds and fixing a bad implementation costs you an hour."}]
20:["$","p","10",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"CLAUDE.md: drop a markdown file in your project root with your stack, your conventions, and anything you're tired of repeating. Claude reads it at the start of every session. Mine says which package manager to use, that I want TypeScript strict mode, and that it should never install a dependency without asking."}]
21:["$","p","11",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Cost: included with Claude Pro at $20 a month. Heavy use pushes you to Max."}]
22:["$","div","12",{"className":"mt-4","children":["$","a",null,{"href":"https://docs.claude.com/en/docs/claude-code/overview","target":"_blank","rel":"noopener noreferrer","className":"inline-flex w-fit items-center gap-1.5 rounded-xl border border-accent/40 bg-accent/10 px-5 py-2.5 text-sm font-semibold text-accent-soft transition-colors hover:bg-accent/20 hover:text-accent","children":["Install Claude Code"," ",["$","span",null,{"aria-hidden":true,"children":"↗"}]]}]}]
23:["$","h2","13",{"className":"mt-12 t-h3 text-ink","children":"Hosting: Vercel"}]
24:["$","p","14",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Vercel connects to your GitHub repo. You push, it builds, it deploys, you get a URL. Every branch gets its own preview link, so you can send a working version of a half-finished feature to a friend without touching production."}]
25:["$","p","15",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"GoDaddy sells you shared hosting and a control panel, and you upload files into it. Nothing rebuilds when you push, nothing rolls back when you break something, and there are no preview URLs because there's no build step. It's a product from before deployment was automatic, and people still buy it because they bought the domain there and clicked the next thing."}]
26:["$","p","16",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Netlify does the same job as Vercel and does it well. Vercel wins on one thing: they build Next.js, so if you're on Next.js the integration is tighter than anyone else can make it."}]
27:["$","div","17",{"className":"mt-6 rounded-xl border border-accent/30 bg-accent/10 px-5 py-4 leading-[1.7] text-ink","children":"Watch out for: serverless functions time out. The default on the free tier is short, so any long job like video processing or a big AI call needs to run somewhere else or run in the background. Learn this before your first timeout teaches it to you."}]
28:["$","p","18",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Cost: free for personal projects. $20 a month per person when you outgrow it."}]
29:["$","div","19",{"className":"mt-4","children":["$","a",null,{"href":"https://vercel.com/new","target":"_blank","rel":"noopener noreferrer","className":"inline-flex w-fit items-center gap-1.5 rounded-xl border border-accent/40 bg-accent/10 px-5 py-2.5 text-sm font-semibold text-accent-soft transition-colors hover:bg-accent/20 hover:text-accent","children":["Deploy on Vercel"," ",["$","span",null,{"aria-hidden":true,"children":"↗"}]]}]}]
2a:["$","h2","20",{"className":"mt-12 t-h3 text-ink","children":"Backend: Supabase"}]
2b:["$","p","21",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Supabase gives you a real Postgres database, plus auth, file storage, and auto-generated APIs on top of it. You get a dashboard to click around your tables and a client library that talks to them from your app."}]
2c:["$","p","22",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"AWS can do all of this and about four hundred other things, and you'll spend your first two days in IAM figuring out why the hell one service can't talk to another. Supabase gives you the same Postgres underneath with the setup already done. When you eventually outgrow it, you're already on standard Postgres, so you leave with your data and your schema intact."}]
2d:["$","p","23",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Firebase is the other common pick and it's fine for prototypes. The problem shows up later: it's NoSQL, so the first time you need to join two collections and sort by a field in the second one, you find out you can't. Postgres does that in one query."}]
2e:["$","p","24",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"The thing that will get you hacked: row level security. Supabase exposes your tables through an API, and the anon key that ships in your frontend is public by design. RLS is what stops a stranger from reading your entire users table. Turn it on for every table and write a policy for each one, even the tables you think are boring."}]
2f:["$","div","25",{"className":"mt-6 rounded-xl border border-accent/30 bg-accent/10 px-5 py-4 leading-[1.7] text-ink","children":"The dashboard warns you when a table is unprotected. Don't click past that warning. This is the single most common way vibecoded apps leak data."}]
30:["$","p","26",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Cost: free tier is generous. $25 a month when you need more."}]
31:["$","div","27",{"className":"mt-4","children":["$","a",null,{"href":"https://supabase.com/docs/guides/getting-started","target":"_blank","rel":"noopener noreferrer","className":"inline-flex w-fit items-center gap-1.5 rounded-xl border border-accent/40 bg-accent/10 px-5 py-2.5 text-sm font-semibold text-accent-soft transition-colors hover:bg-accent/20 hover:text-accent","children":["Supabase quickstart"," ",["$","span",null,{"aria-hidden":true,"children":"↗"}]]}]}]
32:["$","h2","28",{"className":"mt-12 t-h3 text-ink","children":"Payments: Stripe"}]
33:["$","p","29",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Stripe handles checkout, subscriptions, refunds, invoices, failed cards, and the tax paperwork most people forget about. Stripe Checkout gives you a hosted payment page, which means you redirect the user to Stripe, they pay, they come back. You never touch a card number."}]
34:["$","p","30",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"PayPal moves money too. The gap is everything around it. Stripe's docs are the best in the industry, the test mode lets you simulate declined cards and expired subscriptions before you launch, and the dashboard tells you why a payment failed instead of showing you a code. PayPal's developer experience feels like it was finished in 2013 and maintained by people who left."}]
35:["$","p","31",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Lemon Squeezy is worth knowing about. They act as merchant of record, which means they collect and file sales tax and VAT for you across every country you sell to. That's a real problem you'd otherwise solve yourself at 11pm in March. They take a bigger cut for it. If you're selling software to strangers on the internet and you don't want to think about tax, that trade is worth it."}]
36:["$","div","32",{"className":"mt-6 rounded-xl border border-accent/30 bg-accent/10 px-5 py-4 leading-[1.7] text-ink","children":"Watch out for: confirm payment with the webhook, never the redirect. A user who closes the tab before the redirect fires will pay you and never get access, and you won't find out until they email you. The webhook fires regardless."}]
37:["$","p","33",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Cost: 2.9% plus 30 cents per US card charge. No monthly fee."}]
38:["$","div","34",{"className":"mt-4","children":["$","a",null,{"href":"https://docs.stripe.com/checkout/quickstart","target":"_blank","rel":"noopener noreferrer","className":"inline-flex w-fit items-center gap-1.5 rounded-xl border border-accent/40 bg-accent/10 px-5 py-2.5 text-sm font-semibold text-accent-soft transition-colors hover:bg-accent/20 hover:text-accent","children":["Stripe Checkout quickstart"," ",["$","span",null,{"aria-hidden":true,"children":"↗"}]]}]}]
39:["$","h2","35",{"className":"mt-12 t-h3 text-ink","children":"Design: v0"}]
3a:["$","p","36",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"You describe an interface or upload a screenshot, and v0 generates React components using Tailwind and shadcn/ui. That's real code you paste into your project."}]
3b:["$","p","37",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Canva makes images. You can't ship an image. Everything you make there has to be rebuilt by hand in code before a user can click it, so you did the design work twice."}]
3c:["$","p","38",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Figma is the professional answer and designers use it for good reason. For one person building an app alone, Figma is a detour. You spend an hour arranging rectangles that produce zero working code, then you build the thing anyway."}]
3d:["$","p","39",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Use it like this:"}]
3e:["$","ul","40",{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Name the shadcn component you want. \"Use a Sheet for mobile nav\" gets you a much better result than describing the behavior and hoping."}]]}],["$","li","1",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Upload a screenshot of any app whose layout you like and ask for something in that shape."}]]}],["$","li","2",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Ask for responsive behavior out loud, because it doesn't always assume it."}]]}]]}]
3f:["$","p","41",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Where it stops: v0 builds screens. It doesn't build your backend logic or your database schema, and it gets worse when you point it at an existing codebase with its own design system. Generate the UI in v0, then hand the project to Claude Code for everything after that."}]
40:["$","p","42",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Cost: free tier gives you credits to try it, $20 a month after."}]
41:["$","div","43",{"className":"mt-4","children":["$","a",null,{"href":"https://v0.app","target":"_blank","rel":"noopener noreferrer","className":"inline-flex w-fit items-center gap-1.5 rounded-xl border border-accent/40 bg-accent/10 px-5 py-2.5 text-sm font-semibold text-accent-soft transition-colors hover:bg-accent/20 hover:text-accent","children":["Try v0"," ",["$","span",null,{"aria-hidden":true,"children":"↗"}]]}]}]
42:["$","h2","44",{"className":"mt-12 t-h3 text-ink","children":"What this costs"}]
43:["$","p","45",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Free while you build. Around $65 a month once you're paying for Claude, Vercel, and Supabase, plus Stripe's cut of whatever you actually sell. That's less than most people spend on subscriptions they forgot about."}]
44:["$","h2","46",{"className":"mt-12 t-h3 text-ink","children":"The one thing to remember"}]
45:["$","p","47",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Four of these five tools will fail loudly. Your build breaks, your deploy fails, your payment errors out, and you fix it."}]
46:["$","div","48",{"className":"mt-6 rounded-xl border border-accent/30 bg-accent/10 px-5 py-4 leading-[1.7] text-ink","children":"Row level security fails silently. Your app works, your data is readable by anyone who opens the network tab, and nothing tells you until someone finds it. Turn it on first, before you write a single feature."}]
47:["$","section",null,{"className":"read-more","children":[["$","h2",null,{"className":"split-title","children":"Keep reading"}],["$","div",null,{"className":"posts mt-8","children":[["$","$L8","craft-anything-clean-room-clone",{"href":"/vault/craft-anything-clean-room-clone","className":"post","children":[["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/craft-anything-clean-room-clone.webp","width":1200,"height":800,"alt":"","loading":"lazy","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}],["$","span",null,{"className":"post-meta","children":[["$","b",null,{"children":"Tools"}],["$","span",null,{"children":"4 min"}]]}],["$","h3",null,{"className":"post-title","children":"Craft Anything: rebuild any website or app from what you can see"}],["$","p",null,{"className":"post-excerpt line-clamp-3","children":"The free, open source tool from the video. You give it a website, an app or a game, it studies what a visitor can see, Claude Code builds your own version, and then it checks the copy against the original. A one prompt install, how to run your first build, and the fixes for the two bugs people keep hitting."}]]}],["$","$L8","20-github-repos-vibecoders",{"href":"/vault/20-github-repos-vibecoders","className":"post","children":[["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/20-github-repos-vibecoders.webp","width":1200,"height":800,"alt":"","loading":"lazy","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}],["$","span",null,{"className":"post-meta","children":[["$","b",null,{"children":"Tools"}],["$","span",null,{"children":"9 min"}]]}],["$","h3",null,{"className":"post-title","children":"20 GitHub repos every vibecoder should install"}],["$","p",null,{"className":"post-excerpt line-clamp-3","children":"Twenty open source repos for building apps and websites with Claude: security scanners, auth, a database layer, self-hosted deploys and analytics, and the add-ons that make Claude Code better. One prompt that sets them all up, then a short breakdown of each."}]]}],["$","$L8","rea-reverse-engineer-anything",{"href":"/vault/rea-reverse-engineer-anything","className":"post","children":[["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/rea-reverse-engineer-anything.webp","width":1200,"height":800,"alt":"","loading":"lazy","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}],["$","span",null,{"className":"post-meta","children":[["$","b",null,{"children":"Tools"}],["$","span",null,{"children":"3 min"}]]}],["$","h3",null,{"className":"post-title","children":"REA: reverse engineer any feature from any app"}],["$","p",null,{"className":"post-excerpt line-clamp-3","children":"REA lets Claude Code look inside an app you don't have the code for, work out how a feature you like actually works, and build your own version of it. Free and open source. Repo up top, a one prompt install, then how to use it."}]]}]]}]]}]
