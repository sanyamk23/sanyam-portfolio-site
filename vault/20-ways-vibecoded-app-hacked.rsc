11:{"metadata":[["$","title","0",{"children":"20 ways someone hacks your vibecoded app — Sanyam Kumat"}],["$","meta","1",{"name":"description","content":"The video's list, written out. 20 things someone can do to a live app, each with the real case behind it (Next.js, Tea, Stripe, Verizon, OWASP) and the fix. Plus one prompt that checks your own app for every one and reports before it changes anything."}],["$","meta","2",{"property":"og:title","content":"Sanyam Kumat"}],["$","meta","3",{"property":"og:description","content":"I build scalable cloud-native backends, APIs, and AI-powered systems."}],["$","meta","4",{"property":"og:image","content":"https://sanyamk23.github.io/og.jpg"}],["$","meta","5",{"property":"og:image:width","content":"1200"}],["$","meta","6",{"property":"og:image:height","content":"630"}],["$","meta","7",{"property":"og:type","content":"website"}],["$","meta","8",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","9",{"name":"twitter:title","content":"Sanyam Kumat"}],["$","meta","10",{"name":"twitter:description","content":"I build scalable cloud-native backends, APIs, and AI-powered systems."}],["$","meta","11",{"name":"twitter:image","content":"https://sanyamk23.github.io/og.jpg"}],["$","meta","12",{"name":"twitter:image:width","content":"1200"}],["$","meta","13",{"name":"twitter:image:height","content":"630"}],["$","link","14",{"rel":"icon","href":"/icon-m.svg","type":"image/svg+xml"}],["$","link","15",{"rel":"icon","href":"/favicon.ico","sizes":"48x48"}],["$","link","16",{"rel":"apple-touch-icon","href":"/apple-touch-icon.png"}],["$","$L48","17",{}]],"error":null,"digest":"$undefined"}
