1c:["$","p","9",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Claude Code is the agent it supports first. A Codex adapter exists but the README says it hasn't been tested on a real install yet, and GitHub Copilot works through its own CLI with a separate login."}]
