20:["$","div","13",{"className":"mt-7 overflow-x-auto rounded-xl border border-line bg-bg-soft/50","children":["$","table",null,{"className":"w-full min-w-[420px] border-collapse text-left","children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th","0",{"className":"border-b border-line-strong px-5 py-3.5 font-mono text-[12px] text-accent-soft","children":"Mode"}],["$","th","1",{"className":"border-b border-line-strong px-5 py-3.5 font-mono text-[12px] text-accent-soft","children":"What it reads"}],["$","th","2",{"className":"border-b border-line-strong px-5 py-3.5 font-mono text-[12px] text-accent-soft","children":"Use it for"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"className":"border-b border-line last:border-0","children":[["$","td","0",{"className":"px-5 py-3.5 text-[15px] leading-[1.6] text-ink","children":"Clean room (default)"}],["$","td","1",{"className":"px-5 py-3.5 text-[15px] font-semibold leading-[1.6] text-ink","children":"Only what you can see: pictures you add, the site as a visitor sees it, and a picture of an app's window if you allow it. Tools that would look inside get refused."}],["$","td","2",{"className":"px-5 py-3.5 text-[15px] leading-[1.6] text-ink-dim line-through decoration-ink-dim/40","children":"Most builds, and anything that isn't yours."}]]}],["$","tr","1",{"className":"border-b border-line last:border-0","children":[["$","td","0",{"className":"px-5 py-3.5 text-[15px] leading-[1.6] text-ink","children":"Deep"}],["$","td","1",{"className":"px-5 py-3.5 text-[15px] font-semibold leading-[1.6] text-ink","children":"Everything. A program's code and files, a website's JavaScript, and Ghidra if you have it installed."}],["$","td","2",{"className":"px-5 py-3.5 text-[15px] leading-[1.6] text-ink-dim line-through decoration-ink-dim/40","children":"Your own software, for your private use."}]]}]]}]]}]}]
21:["$","p","14",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"You switch modes in the title bar or in Settings. Clean room is a rule about which tools Craft Anything will use. It doesn't sandbox your computer, and installing a build's dependencies runs code like any other project, so only click always allow for projects you trust."}]
22:["$","h2","15",{"className":"mt-12 t-h3 text-ink","children":"If it breaks"}]
