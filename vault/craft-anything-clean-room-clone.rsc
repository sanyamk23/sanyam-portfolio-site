1e:["$","ol","11",{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[1,"."]}],["$","span",null,{"children":"Open the app. It asks what you want to make. Pick a website, an app or a game."}]]}],["$","li","1",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[2,"."]}],["$","span",null,{"children":"Type the address, or pick the app. Start with a site of your own, it's the easiest way to see how close it gets."}]]}],["$","li","2",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[3,"."]}],["$","span",null,{"children":"Leave Clean room on."}]]}],["$","li","3",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[4,"."]}],["$","span",null,{"children":"Say what you want, in plain words. \"Recreate this website\" works, and so does \"Build me a PDF editor that looks and works like this app.\""}]]}],["$","li","4",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[5,"."]}],["$","span",null,{"children":"Press Start and watch the four steps: Study, Build, Check, Ready. It may stop to ask you something, and it asks before it runs a new kind of command. Answer and it keeps going."}]]}],["$","li","5",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[6,"."]}],["$","span",null,{"children":"At Ready you can open the result or its folder. Anything you want changed, type it in the box at the bottom and it refines the build."}]]}]]}]
