32:["$","div","29",{"className":"mt-5","children":[["$","div",null,{"className":"mb-2 flex items-center justify-between gap-4","children":[["$","span",null,{"className":"font-mono text-[12px] text-ink-dim","children":"Deploy"}],["$","$L3b",null,{"text":"Get this app ready to deploy. I'm using [Vercel / Netlify / Cloudflare] for hosting, [Supabase / Firebase] for the backend, and Stripe for payments.\n\n1. List every environment variable the app needs, what it's for, and exactly where I get each one.\n2. Make sure no secret key is in the code or the frontend bundle.\n3. Set up the database tables and security rules from our schema, with row level security on for every table.\n4. Connect Stripe in test mode first, with a webhook that checks the signature.\n5. Walk me through every click I need to make in each dashboard, one step at a time."}]]}],["$","pre",null,{"className":"rounded-xl bg-[#0a1020] p-5 font-mono text-[13px] leading-[1.7] text-[#e4e9f5] whitespace-pre-wrap break-words","children":["$","code",null,{"children":"Get this app ready to deploy. I'm using [Vercel / Netlify / Cloudflare] for hosting, [Supabase / Firebase] for the backend, and Stripe for payments.\n\n1. List every environment variable the app needs, what it's for, and exactly where I get each one.\n2. Make sure no secret key is in the code or the frontend bundle.\n3. Set up the database tables and security rules from our schema, with row level security on for every table.\n4. Connect Stripe in test mode first, with a webhook that checks the signature.\n5. Walk me through every click I need to make in each dashboard, one step at a time."}]}]]}]
