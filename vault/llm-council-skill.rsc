a:[["$","header",null,{"className":"head pad","children":[["$","canvas",null,{"className":"head-code","id":"head-code","aria-hidden":"true"}],["$","div",null,{"className":"head-grid split","children":[["$","div",null,{"className":"head-text","children":[["$","div",null,{"className":"head-meta","children":[["$","$L8",null,{"href":"/vault","aria-label":"Back to the Vault","children":"← /vault"}],["$","span",null,{"children":"Mindset"}],["$","span",null,{"children":["4 min"," read"]}]]}],["$","h1",null,{"className":"head-title","data-head":true,"aria-label":"What the LLM Council skill is","children":[["$","span","0",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"What"}]," "]}],["$","span","1",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"the"}]," "]}],["$","span","2",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"LLM"}]," "]}],["$","span","3",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"Council"}]," "]}],["$","span","4",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"skill"}]," "]}],["$","span","5",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"is"}],null]}]]}],["$","$L7",null,{"onMount":true,"delay":0.2,"y":12,"children":[["$","p",null,{"className":"head-lede","children":"Run any high-stakes decision through five AI advisors who argue, peer-review each other anonymously, and hand you a verdict. Based on Karpathy's LLM Council."}],["$","div",null,{"className":"head-action","children":["$","a",null,{"href":"/llm-council.skill","download":true,"className":"btn-primary px-6 py-3 text-sm","children":[["$","span",null,{"aria-hidden":true,"children":"↓"}]," ","Download the LLM Council skill"]}]}]]}]]}],["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/llm-council-skill.webp","width":1200,"height":800,"alt":"","fetchPriority":"hig