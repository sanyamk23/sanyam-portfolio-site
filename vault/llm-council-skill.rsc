ren":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"I'm thinking of pivoting from X to Y. Am I crazy?"}]]}],["$","li","3",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],"$L17"]}]]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e"]}]}],"$L1f"]}]]}],"$L20"]
