d:[["$","header",null,{"className":"head pad","children":[["$","canvas",null,{"className":"head-code","id":"head-code","aria-hidden":"true"}],["$","div",null,{"className":"head-grid split","children":[["$","div",null,{"className":"head-text","children":[["$","div",null,{"className":"head-meta","children":[["$","$L8",null,{"href":"/vault","aria-label":"Back to the Vault","children":"← /vault"}],["$","span",null,{"children":"Shipping"}],["$","span",null,{"children":["7 min"," read"]}]]}],["$","h1",null,{"className":"head-title","data-head":true,"aria-label":"10 more ways your app is getting sued (expensive edition)","children":[["$","span","0",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"10"}]," "]}],["$","span","1",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"more"}]," "]}],["$","span","2",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"ways"}]," "]}],["$","span","3",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"your"}]," "]}],["$","span","4",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"app"}]," "]}],["$","span","5",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"is"}]," "]}],["$","span","6",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"getting"}]," "]}],["$","span","7",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"sued"}]," "]}],["$","span","8",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"(expensive"}]," "]}],["$","span","9",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"edition)"}],null]}]]}],["$","$L7",null,{"onMount":true,"delay":0.2,"y":12,"children":[["$","p",null,{"className":"head-lede","children":"Part 1 was paperwork. This one is code. Ten things scanners find in vibe coded apps, priced cheapest to most expensive, and every fix is a code change or a checkbox."}],null]}]]}],["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/10-more-ways-to-get-your-app-sued.webp","width":1200,"height":800,"alt":"","fetchPriority":"high","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}]]}]]}],["$","div",null,{"className":"sheet","children":[["$","canvas",null,{"className":"seam","data-seam":"#F5F2EA","aria-hidden":"true"}],["$","div",null,{"className":"pad sheet-in","children":[["$","article",null,{"className":"read guide","children":["$","div",null,{"children":[["$","div","0",{"className":"mt-6 rounded-xl border border-accent/30 bg-accent/10 px-5 py-4 leading-[1.7] text-ink","children":"I'm not a lawyer and this isn't legal advice, it's a checklist. If your app takes money or personal data, pay someone with a license to look at it."}],["$","p","1",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Part 1 was paperwork. This one is code, and nobody has to notice you first. Accessibility firms, pixel firms and text message firms run scanners across the whole internet and mail a demand letter to whatever trips. Small apps get hit because they're cheap to settle."}],["$","p","2",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Two things are different this time. The items run cheapest to most expensive, and every fix is a code change or a checkbox instead of a document you have to write."}],["$","div","3",{"className":"mt-6 rounded-xl border border-accent/30 bg-accent/10 px-5 py-4 leading-[1.7] text-ink","children":"Total, one violation of each: $1,135,037."}],["$","h2","4",{"className":"mt-12 t-h3 text-ink","children":"1. Marketing texts without opt-in"}],["$","p","5",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"You wired a \"we miss you\" or \"your cart is waiting\" SMS into the app with no prior express written consent and no STOP handling. Verification codes are fine. Marketing is not."}],["$","p","6",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"$$500 per text. $1,500 per text if a court decides it was willful. That's TCPA statutory damages, 47 U.S.C. 227(b)(3), and it's per message, not per user."}],["$","p","7",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: split transactional SMS from marketing SMS. Put an unchecked consent box in front of the marketing texts, store the timestamp and IP, handle STOP and HELP in code, and send nothing before 8am or after 9pm local time."}],"$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d"]}]}],"$L4e"]}]]}],"$L4f"]
50:I[6502,["619","static/chunks/619-ba102abea3e3d0e4.js","506","static/chunks/506-51bde6540850d248.js","867","static/chunks/app/vault/%5Bslug%5D/page-cbc8dd1a06312276.js"],"CopyButton"]
17:["$","h2","8",{"className":"mt-12 t-h3 text-ink","children":"2. No DMCA agent registered"}]
18:["$","p","9",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"You built user uploads, images, posts, audio, and assumed the platform shield covers you. The safe harbor only applies if you registered a designated agent with the Copyright Office. It costs $6 and takes ten minutes."}]
19:["$","p","10",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Without it, every infringing upload is yours. $750 to $30,000 per work, up to $150,000 if willful, under 17 U.S.C. 504(c)."}]
1a:["$","p","11",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: register the agent, publish the agent contact on a /dmca page, add a takedown route in the app, renew every three years."}]
1b:["$","h2","12",{"className":"mt-12 t-h3 text-ink","children":"3. User data stored unencrypted"}]
1c:["$","p","13",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"PII sitting in plain text in the database, the open Supabase table from the hacked video. This is what it costs you after the breach, and it's paid to the users, not the regulator."}]
1d:["$","p","14",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"$$107 to $799 per California user per incident. That's the CCPA private right of action, Cal. Civ. Code 1798.150, and the plaintiffs don't have to prove a loss or show anyone was harmed."}]
1e:["$","p","15",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: RLS on, encryption at rest, MFA on your admin, and a written 72 hour notification step. \"Reasonable security\" is the defense, so keep receipts that you had it."}]
1f:["$","h2","16",{"className":"mt-12 t-h3 text-ink","children":"4. Chatbot with no policy guardrails"}]
20:["$","p","17",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"You shipped a support bot with a friendly system prompt and nothing stopping it from stating prices, refunds or policies."}]
21:["$","p","18",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Moffatt v. Air Canada, 2024 BCCRT 149. The bot invented a bereavement refund policy. Air Canada argued the chatbot was \"a separate legal entity that is responsible for its own actions.\" The tribunal rejected that and awarded C$812.02 in damages. Small number, but every founder now inherits the precedent: whatever your bot says, you said."}]
22:["$","p","19",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: the system prompt forbids stating prices, refunds, medical, legal or financial claims. Pull policies from a source of truth instead of generating them. Log every conversation. Put a visible \"confirm with support\" line under the chat."}]
23:["$","h2","20",{"className":"mt-12 t-h3 text-ink","children":"5. Face ID login without consent form"}]
24:["$","p","21",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Face login, voice clone, or an avatar built from a selfie, with no written consent screen. One Illinois user is enough to file."}]
25:["$","p","22",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"$$1,000 per negligent violation, $5,000 per intentional one, per scan, under Illinois BIPA, 740 ILCS 14/20. Meta paid $650 million. Google paid $100 million. Clearview paid $51.75 million."}]
26:["$","p","23",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: a consent screen before capture that names what you collect, why, and for how long. A published retention and deletion schedule. Never sell or share templates. Can't do that? Don't ship the feature to Illinois."}]
27:["$","h2","24",{"className":"mt-12 t-h3 text-ink","children":"6. Meta pixel before cookie banner"}]
28:["$","p","25",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"You pasted the pixel or GA4 tag into the layout file. It fires on every page before the consent banner does anything. Plaintiff firms record the network traffic and mail the letter."}]
29:["$","p","26",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"$$5,000 per visitor under California's wiretap law, CIPA, Cal. Penal Code 631 and 632. If your site has video, add $2,500 per person under the VPPA, 18 U.S.C. 2710."}]
2a:["$","p","27",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: a consent tool that actually blocks the tag until the user opts in. A banner that hides itself while the tag fires anyway doesn't count. No pixels on video pages or sensitive flows, and check the Network tab in a private window before every deploy."}]
2b:["$","h2","28",{"className":"mt-12 t-h3 text-ink","children":"7. No alt text on images"}]
2c:["$","p","29",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"No alt text, no focus states, gray-on-gray text, modals you can't close with a keyboard."}]
2d:["$","p","30",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Around $20,000 per lawsuit, which is the typical low five figure settlement. No statute sets that number, it's just the going rate. 3,117 federal website accessibility suits were filed in 2025, up 27%, with state courts on top of that."}]
2e:["$","p","31",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: run axe or Lighthouse accessibility, fix everything red, tab through every flow with the mouse unplugged, 4.5:1 contrast. Half a day. Do not buy an overlay. See item 10."}]
2f:["$","h2","32",{"className":"mt-12 t-h3 text-ink","children":"8. No age gate at signup"}]
30:["$","p","33",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Email and password signup with no age question, on an app kids are obviously going to use."}]
31:["$","p","34",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Up to $53,088 per violation under COPPA, from the FTC's civil penalty schedule at 16 CFR 1.98. Texas adds up to $10,000 per violation under the App Store Accountability Act, in force since June 4, 2026, and lets parents sue you directly."}]
32:["$","p","35",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: a neutral age gate at signup. Block anyone under 13 unless you build the full COPPA consent flow. Wire the Apple and Google age-range APIs if you ship mobile. No behavioral ads to anyone under 18."}]
33:["$","h2","36",{"className":"mt-12 t-h3 text-ink","children":"9. Emails with no unsubscribe link"}]
34:["$","p","37",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"A signup form the AI wired straight into a mailing loop with no footer, no postal address, no opt-out. Or you bought a list."}]
35:["$","p","38",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Up to $53,088 per email. Same penalty schedule as item 8, applied through CAN-SPAM, and every message counts on its own."}]
36:["$","p","39",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: one-click unsubscribe and a real postal address in every marketing email, honest from-name and subject, honor opt-outs within 10 business days, never send to a purchased list."}]
37:["$","h2","40",{"className":"mt-12 t-h3 text-ink","children":"10. \"AI-powered\" with no proof"}]
38:["$","p","41",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"The landing page says your app \"uses AI to detect / diagnose / guarantee\" and the code is a prompt wrapper with no test result behind the claim."}]
39:["$","p","42",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"$$1,000,000. That's what accessiBe paid in April 2025 for claiming its AI overlay makes sites accessibility-compliant. DoNotPay paid $193,000 for the \"robot lawyer\" and Workado signed a consent order in the same FTC sweep."}]
3a:["$","p","43",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Fix: every capability claim needs a test result you can produce. Say \"assists\" not \"detects\" unless you measured it. No accuracy percentages you can't reproduce."}]
3b:["$","div","44",{"className":"mt-6 rounded-xl border border-accent/30 bg-accent/10 px-5 py-4 leading-[1.7] text-ink","children":"Total, one violation of each: $1,135,037."}]
3c:["$","p","45",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Every one of these takes about fifteen minutes to fix, which is a lot less than the lawsuit takes."}]
3d:["$","h2","46",{"className":"mt-12 t-h3 text-ink","children":"Paste this into Claude"}]
3e:["$","div","47",{"className":"mt-5","children":[["$","div",null,{"className":"mb-2 flex items-center justify-between gap-4","children":[["$","span",null,{"className":"font-mono text-[12px] text-ink-dim","children":"Copy and paste"}],["$","$L50",null,{"text":"Audit this codebase for: SMS sending without consent tracking, user upload features with no DMCA takedown route, unencrypted personal data at rest, analytics or pixel scripts loading before consent, missing alt text and keyboard handling, signup flows with no age gate, marketing email without an unsubscribe link, chatbot system prompts that let the model state prices, refunds or policies, and any marketing copy claiming AI capabilities. List each finding with file and line."}]]}],["$","pre",null,{"className":"rounded-xl bg-[#0a1020] p-5 font-mono text-[13px] leading-[1.7] text-[#e4e9f5] overflow-x-auto","children":["$","code",null,{"children":"Audit this codebase for: SMS sending without consent tracking, user upload features with no DMCA takedown route, unencrypted personal data at rest, analytics or pixel scripts loading before consent, missing alt text and keyboard handling, signup flows with no age gate, marketing email without an unsubscribe link, chatbot system prompts that let the model state prices, refunds or policies, and any marketing copy claiming AI capabilities. List each finding with file and line."}]}]]}]
3f:["$","h2","48",{"className":"mt-12 t-h3 text-ink","children":"Sources"}]
