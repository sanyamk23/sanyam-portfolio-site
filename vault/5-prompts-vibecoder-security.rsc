d:[["$","header",null,{"className":"head pad","children":[["$","canvas",null,{"className":"head-code","id":"head-code","aria-hidden":"true"}],["$","div",null,{"className":"head-grid split","children":[["$","div",null,{"className":"head-text","children":[["$","div",null,{"className":"head-meta","children":[["$","$L8",null,{"href":"/vault","aria-label":"Back to the Vault","children":"← /vault"}],["$","span",null,{"children":"Shipping"}],["$","span",null,{"children":["6 min"," read"]}]]}],["$","h1",null,{"className":"head-title","data-head":true,"aria-label":"Vibecoders don't know shit about security. These 5 prompts fix that.","children":[["$","span","0",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"Vibecoders"}]," "]}],["$","span","1",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"don't"}]," "]}],["$","span","2",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"know"}]," "]}],["$","span","3",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"shit"}]," "]}],["$","span","4",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"about"}]," "]}],["$","span","5",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"security."}]," "]}],["$","span","6",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"These"}]," "]}],["$","span","7",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"5"}]," "]}],["$","span","8",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"prompts"}]," "]}],["$","span","9",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"fix"}]," "]}],["$","span","10",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"that."}],null]}]]}],["$","$L7",null,{"onMount":true,"delay":0.2,"y":12,"children":[["$","p",null,{"className":"head-lede","children":"Secrets, auth, database rules, user input, and the cost bomb nobody warns you about. Five prompts, one per attack surface, run before you ship."}],null]}]]}],["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/5-prompts-vibecoder-security.webp","width":1200,"height":800,"alt":"","fetchPriority":"high","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}]]}]]}],["$","div",null,{"className":"sheet","children":[["$","canvas",null,{"className":"seam","data-seam":"#F5F2EA","aria-hidden":"true"}],["$","div",null,{"className":"pad sheet-in","children":[["$","article",null,{"className":"read guide","children":["$","div",null,{"children":[["$","p","0",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"You vibecoded an app that works. It signs people up, it takes their data, maybe it takes their money. The model that built it optimized for working, and nobody asked it about safe."}],["$","p","1",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"The good news is the same model will find its own mistakes if you point it at them with the right words. Below are five prompts, one per attack surface. Open Claude Code at the root of your project, run them in order, and fix the CRITICALs before you touch anything else."}],["$","h2","2",{"className":"mt-12 t-h3 text-ink","children":"1. The secrets sweep"}],["$","p","3",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Bots scrape GitHub for leaked keys within minutes of a push, and deleting the file later saves you nothing because git keeps the history. This prompt hunts hardcoded keys, committed .env files, and secrets buried in old commits. Then it tells you which keys to rotate, because a key that ever touched a public file is burned no matter where you hide it now."}],["$","div","4",{"className":"mt-5","children":[["$","div",null,{"className":"mb-2 flex items-center justify-between gap-4","children":[["$","span",null,{"className":"font-mono text-[12px] text-ink-dim","children":"Copy and paste"}],["$","$L17",null,{"text":"Act as a security researcher auditing my repo for exposed secrets. Find:\n\n1. Hardcoded API keys, tokens, passwords, or connection strings in any file\n2. .env files that are committed or missing from .gitignore\n3. Secrets in git history even if the file was deleted later\n4. Secrets that ship to the browser in frontend code or build output\n5. Public/anon keys doing privileged work\n\nOutput a table: file and line | what leaked | how an attacker finds it |\nseverity (CRITICAL / HIGH / MEDIUM) | exact fix.\n\nThen list every key I need to rotate. A key that ever touched a commit is\nburned, hiding it now is not enough."}]]}],"$L18"]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]}],"$L2a"]}]]}],"$L2b"]
18:["$","pre",null,{"className":"rounded-xl bg-[#0a1020] p-5 font-mono text-[13px] leading-[1.7] text-[#e4e9f5] overflow-x-auto","children":["$","code",null,{"children":"Act as a security researcher auditing my repo for exposed secrets. Find:\n\n1. Hardcoded API keys, tokens, passwords, or connection strings in any file\n2. .env files that are committed or missing from .gitignore\n3. Secrets in git history even if the file was deleted later\n4. Secrets that ship to the browser in frontend code or build output\n5. Public/anon keys doing privileged work\n\nOutput a table: file and line | what leaked | how an attacker finds it |\nseverity (CRITICAL / HIGH / MEDIUM) | exact fix.\n\nThen list every key I need to rotate. A key that ever touched a commit is\nburned, hiding it now is not enough."}]}]
19:["$","h2","5",{"className":"mt-12 t-h3 text-ink","children":"2. The auth teardown"}]
1a:["$","p","6",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Your login page is a door. This prompt checks whether the walls around it exist: routes that skip the session check, tokens that never expire, password rules you left off, reset flows that let a stranger claim someone else's account. The finding that shows up in almost every vibecoded app: an endpoint that trusts the user ID sent in the request instead of the one on the session."}]
1b:["$","div","7",{"className":"mt-5","children":[["$","div",null,{"className":"mb-2 flex items-center justify-between gap-4","children":[["$","span",null,{"className":"font-mono text-[12px] text-ink-dim","children":"Copy and paste"}],["$","$L17",null,{"text":"Attack my authentication like you want in. Walk every auth path in this repo:\n\n1. List every route and API endpoint and whether it verifies a valid session.\n   Flag any that skip it.\n2. Session handling: where tokens live, whether they expire, whether logout and\n   password change kill them\n3. Password rules: minimum length, breached-password check, anything my auth\n   provider offers that I left off\n4. Password reset and email verification: can I reset someone else's password,\n   or use the app with an unverified email?\n\nOutput: flow | weakness | exact exploit steps | severity | fix.\n\nAny endpoint that trusts a user ID from the request body instead of the session\nis CRITICAL."}]]}],["$","pre",null,{"className":"rounded-xl bg-[#0a1020] p-5 font-mono text-[13px] leading-[1.7] text-[#e4e9f5] overflow-x-auto","children":["$","code",null,{"children":"Attack my authentication like you want in. Walk every auth path in this repo:\n\n1. List every route and API endpoint and whether it verifies a valid session.\n   Flag any that skip it.\n2. Session handling: where tokens live, whether they expire, whether logout and\n   password change kill them\n3. Password rules: minimum length, breached-password check, anything my auth\n   provider offers that I left off\n4. Password reset and email verification: can I reset someone else's password,\n   or use the app with an unverified email?\n\nOutput: flow | weakness | exact exploit steps | severity | fix.\n\nAny endpoint that trusts a user ID from the request body instead of the session\nis CRITICAL."}]}]]}]
1c:["$","h2","8",{"className":"mt-12 t-h3 text-ink","children":"3. The database interrogation"}]
1d:["$","p","9",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"On Supabase, your anon key ships to every visitor's browser. Row level security is the only thing standing between that key and your entire users table. This prompt goes table by table and writes the exact query an attacker would run to read someone else's rows, so you see the leak instead of taking a policy's word for it."}]
1e:["$","div","10",{"className":"mt-5","children":[["$","div",null,{"className":"mb-2 flex items-center justify-between gap-4","children":[["$","span",null,{"className":"font-mono text-[12px] text-ink-dim","children":"Copy and paste"}],["$","$L17",null,{"text":"Audit my database access rules table by table (Supabase RLS or equivalent).\n\n1. List every table and whether RLS is enabled. Any table reachable with the\n   public key and no RLS is CRITICAL.\n2. For each policy, write the exact query user A runs to read or edit user B's\n   rows, and tell me whether it works.\n3. Flag policies that filter on values the client sends instead of auth.uid().\n4. Check INSERT and UPDATE policies, not just SELECT: can I insert rows pointed\n   at another user, or update columns I shouldn't own, like role or credits?\n5. Apply the same checks to storage buckets.\n\nOutput: table | policy state | the attack query | what leaks | severity |\ncorrected policy as real SQL."}]]}],["$","pre",null,{"className":"rounded-xl bg-[#0a1020] p-5 font-mono text-[13px] leading-[1.7] text-[#e4e9f5] overflow-x-auto","children":["$","code",null,{"children":"Audit my database access rules table by table (Supabase RLS or equivalent).\n\n1. List every table and whether RLS is enabled. Any table reachable with the\n   public key and no RLS is CRITICAL.\n2. For each policy, write the exact query user A runs to read or edit user B's\n   rows, and tell me whether it works.\n3. Flag policies that filter on values the client sends instead of auth.uid().\n4. Check INSERT and UPDATE policies, not just SELECT: can I insert rows pointed\n   at another user, or update columns I shouldn't own, like role or credits?\n5. Apply the same checks to storage buckets.\n\nOutput: table | policy state | the attack query | what leaks | severity |\ncorrected policy as real SQL."}]}]]}]
1f:["$","div","11",{"className":"mt-6 rounded-xl border border-accent/30 bg-accent/10 px-5 py-4 leading-[1.7] text-ink","children":"Don't accept \"the policy looks correct\" as an answer. Make it write the attacker's query and run it. A policy that reads right and filters wrong is the most common way a users table ends up on the internet."}]
20:["$","h2","12",{"className":"mt-12 t-h3 text-ink","children":"4. The input audit"}]
21:["$","p","13",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Every text box on your app is a place where a stranger types instructions to your server. Unsanitized, that input closes your SQL quote and appends its own query, or plants a script that runs in every other visitor's browser, or uploads a file your server ends up executing. This prompt traces each path from input to something dangerous."}]
22:["$","div","14",{"className":"mt-5","children":[["$","div",null,{"className":"mb-2 flex items-center justify-between gap-4","children":[["$","span",null,{"className":"font-mono text-[12px] text-ink-dim","children":"Copy and paste"}],["$","$L17",null,{"text":"Trace every path where user input reaches something dangerous in this repo:\n\n1. SQL or NoSQL queries built with string concatenation or template literals\n   instead of parameters\n2. Input passed to eval, exec, child_process, or shell commands\n3. File uploads: is the filename sanitized, is the type verified server-side,\n   can I upload an executable or path-traverse with ../\n4. User content rendered as HTML without escaping, including\n   dangerouslySetInnerHTML and markdown renderers\n5. Endpoints with no server-side validation at all\n\nOutput: file and line | input source | what it reaches | a working example\npayload | severity | fix."}]]}],["$","pre",null,{"className":"rounded-xl bg-[#0a1020] p-5 font-mono text-[13px] leading-[1.7] text-[#e4e9f5] overflow-x-auto","children":["$","code",null,{"children":"Trace every path where user input reaches something dangerous in this repo:\n\n1. SQL or NoSQL queries built with string concatenation or template literals\n   instead of parameters\n2. Input passed to eval, exec, child_process, or shell commands\n3. File uploads: is the filename sanitized, is the type verified server-side,\n   can I upload an executable or path-traverse with ../\n4. User content rendered as HTML without escaping, including\n   dangerouslySetInnerHTML and markdown renderers\n5. Endpoints with no server-side validation at all\n\nOutput: file and line | input source | what it reaches | a working example\npayload | severity | fix."}]}]]}]
23:["$","h2","15",{"className":"mt-12 t-h3 text-ink","children":"5. The cost bomb check"}]
24:["$","p","16",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Your app has routes that cost you money every time they run, and your AI endpoints are the worst offenders. No rate limit means one script, one night, and a four-figure bill on your card before you wake up. This prompt finds every route that spends your money and asks what stops a bot from hammering it."}]
25:["$","div","17",{"className":"mt-5","children":[["$","div",null,{"className":"mb-2 flex items-center justify-between gap-4","children":[["$","span",null,{"className":"font-mono text-[12px] text-ink-dim","children":"Copy and paste"}],["$","$L17",null,{"text":"Find every endpoint in this app that costs me money or resources when called,\nand check its protection:\n\n1. Routes that trigger AI or LLM API calls: what stops a script from calling\n   each one 100,000 times tonight? Check auth, per-user limits, per-IP limits.\n2. Login, signup, and password reset: rate limits, bot protection, and whether\n   response differences let someone enumerate valid emails\n3. Email or SMS sending routes someone can spam through\n4. Expensive queries or exports with no caps or pagination\n5. Usage metering: is it enforced server-side, and does it fail closed?\n\nOutput: endpoint | what one call costs me | the abuse scenario | projected\ndamage from one night | severity | the exact limiter to add."}]]}],["$","pre",null,{"className":"rounded-xl bg-[#0a1020] p-5 font-mono text-[13px] leading-[1.7] text-[#e4e9f5] overflow-x-auto","children":["$","code",null,{"children":"Find every endpoint in this app that costs me money or resources when called,\nand check its protection:\n\n1. Routes that trigger AI or LLM API calls: what stops a script from calling\n   each one 100,000 times tonight? Check auth, per-user limits, per-IP limits.\n2. Login, signup, and password reset: rate limits, bot protection, and whether\n   response differences let someone enumerate valid emails\n3. Email or SMS sending routes someone can spam through\n4. Expensive queries or exports with no caps or pagination\n5. Usage metering: is it enforced server-side, and does it fail closed?\n\nOutput: endpoint | what one call costs me | the abuse scenario | projected\ndamage from one night | severity | the exact limiter to add."}]}]]}]
26:["$","h2","18",{"className":"mt-12 t-h3 text-ink","children":"How to run this"}]
27:["$","ol","19",{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[1,"."]}],["$","span",null,{"children":"Open Claude Code (or Cursor) at the root of your project."}]]}],["$","li","1",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[2,"."]}],["$","span",null,{"children":"Run the prompts in order, one at a time. Each produces a findings table."}]]}],["$","li","2",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[3,"."]}],["$","span",null,{"children":"Fix every CRITICAL before moving to the next prompt."}]]}],["$","li","3",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[4,"."]}],["$","span",null,{"children":"Re-run the prompt after your fixes and make it confirm the hole is closed."}]]}],["$","li","4",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[5,"."]}],["$","span",null,{"children":"Repeat the full pass after every big feature, because new code ships new holes."}]]}]]}]
28:["$","p","20",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"One warning: these prompts produce findings, and the first run on a real app usually produces a lot of them. That feeling in your stomach is the point. Better you find them on a Tuesday than a stranger finds them on launch day."}]
29:["$","p","21",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Run all five before every ship. It takes twenty minutes. A real audit costs five grand and this one costs you a lunch break."}]
