49:["$","ul","49",{"className":"mt-5 divide-y divide-line border-y border-line","children":[["$","li","/vault/20-ways-vibecoded-app-hacked",{"children":["$","a",null,{"href":"/vault/20-ways-vibecoded-app-hacked","className":"group flex items-start gap-4 py-3.5","children":[["$","span",null,{"className":"min-w-0 flex-1","children":[["$","span",null,{"className":"block font-semibold text-ink transition-colors group-hover:text-accent","children":"20 ways someone hacks your vibecoded app"}],["$","span",null,{"className":"mt-0.5 block text-[15px] leading-[1.6] text-ink-soft","children":"What the scanners above are looking for, with the real cases."}]]}],["$","span",null,{"aria-hidden":true,"className":"mt-0.5 text-ink-dim transition-colors group-hover:text-accent","children":"→"}]]}]}],["$","li","/vault/10-signs-website-ai-slop-design-rules",{"children":["$","a",null,{"href":"/vault/10-signs-website-ai-slop-design-rules","className":"group flex items-start gap-4 py-3.5","children":[["$","span",null,{"className":"min-w-0 flex-1","children":[["$","span",null,{"className":"block font-semibold text-ink transition-colors group-hover:text-accent","children":"10 signs your website is AI slop"}],["$","span",null,{"className":"mt-0.5 block text-[15px] leading-[1.6] text-ink-soft","children":"Read before you add React Bits to everything."}]]}],["$","span",null,{"aria-hidden":true,"className":"mt-0.5 text-ink-dim transition-colors group-hover:text-accent","children":"→"}]]}]}],["$","li","/vault/6-claude-code-habits",{"children":["$","a",null,{"href":"/vault/6-claude-code-habits","className":"group flex items-start gap-4 py-3.5","children":[["$","span",null,{"className":"min-w-0 flex-1","children":[["$","span",null,{"className":"block font-semibold text-ink transition-colors group-hover:text-accent","children":"6 Claude Code habits"}],["$","span",null,{"className":"mt-0.5 block text-[15px] leading-[1.6] text-ink-soft","children":"Keeping Claude sharp once all of this is installed."}