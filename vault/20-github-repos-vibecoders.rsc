4a:["$","section",null,{"className":"read-more","children":[["$","h2",null,{"className":"split-title","children":"Keep reading"}],["$","div",null,{"className":"posts mt-8","children":[["$","$L8","craft-anything-clean-room-clone",{"href":"/vault/craft-anything-clean-room-clone","className":"post","children":[["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/craft-anything-clean-room-clone.webp","width":1200,"height":800,"alt":"","loading":"lazy","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}],["$","span",null,{"className":"post-meta","children":[["$","b",null,{"children":"Tools"}],["$","span",null,{"children":"4 min"}]]}],["$","h3",null,{"className":"post-title","children":"Craft Anything: rebuild any website or app from what you can see"}],["$","p",null,{"className":"post-excerpt line-clamp-3","children":"The free, open source tool from the video. You give it a website, an app or a game, it studies what a visitor can see, Claude Code builds your own version, and then it checks the copy against the original. A one prompt install, how to run your first build, and the fixes for the two bugs people keep hitting."}]]}],["$","$L8","rea-reverse-engineer-anything",{"href":"/vault/rea-reverse-engineer-anything","className":"post","children":[["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/rea-reverse-engineer-anything.webp","width":1200,"height":800,"alt":"","loading":"lazy","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}],["$","span",null,{"className":"post-meta","children":[["$","b",null,{"children":"Tools"}],["$","span",null,{"children":"3 min"}]]}],["$","h3",null,{"className":"post-title","children":"REA: reverse engineer any feature from any app"}],["$","p",null,{"className":"post-excerpt line-clamp-3","children":"REA lets Claude Code look inside an app you don't have the code for, work out how a feature you like actually works, and build your own version of it. Free and open source. Repo up top, a one prompt install, then how to use it."}]]}],["$","$L8","saved-reels-to-claude-skill",{"href":"/vault/saved-reels-to-claude-skill","className":"post","children":[["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/saved-reels-to-claude-skill.webp","width":1200,"height":800,"alt":"","loading":"lazy","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}],["$","span",null,{"className":"post-meta","children":[["$","b",null,{"children":"Tools"}],["$","span",null,{"children":"3 min"}]]}],["$","h3",null,{"className":"post-title","children":"Turn your saved reels into a Claude skill"}],["$","p",null,{"className":"post-excerpt line-clamp-3","children":"Claude watches every reel you saved, transcribes it, checks each technique against the official docs and your own projects, and hands you a ranked list of what to do first. Download the skill, install a few tools, paste one prompt."}]]}]]}]]}]
4b:["$","section",null,{"id":"ask","className":"band pad","children":[["$","canvas",null,{"className":"seam","data-seam":"#2b57c8","aria-hidden":"true"}],["$","canvas",null,{"className":"ask-field","id":"ask-field","aria-hidden":"true"}],["$","div",null,{"className":"band-grid","children":[["$","div",null,{"children":[["$","h2",null,{"className":"h1","data-decrypt":true,"aria-label":"Want yours built?","children":[["$","span","0",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"Want"}]," "]}],["$","span","1",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"yours"}]," "]}],["$","span","2",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"built?"}],null]}]]}],["$","p",null,{"className":"lede","children":"Two minutes of questions, and our first call starts with the work instead of an intro."}]]}],["$","div",null,{"children":[["$","$L8",null,{"href":"/consult","className":"band-go","data-scramble":true,"children":[["$","span",null,{"data-label":true,"children":"Tell me about your project"}],["$","svg",null,{"width":18,"height":18,"viewBox":"0 0 18 18","fill":"none","stroke":"currentColor","strokeWidth":"1.8","aria-hidden":"true","children":["$","path",null,{"d":"M2 9h13M10 4l5 5-5 5"}]}]]}],["$","span",null,{"className":"band-price","children":["Focus: ","Backend, cloud, AI"]}]]}]]}]]}]
