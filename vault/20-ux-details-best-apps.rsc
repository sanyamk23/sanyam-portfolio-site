11:{"metadata":[["$","title","0",{"children":"20 UX details the best apps use, and the prompt that adds them to yours — Sanyam Kumat"}],["$","meta","1",{"name":"description","content":"Skeleton loaders from Apple, the command menu from Linear, undo toasts from Gmail, Amazon's safe triangle. All twenty from the video, what each one does, plus one prompt that has Claude check your app for every one and build what's missing."}],["$","meta","2",{"property":"og:title","content":"Sanyam Kumat"}],["$","meta","3",{"property":"og:description","content":"I build scalable cloud-native backends, APIs, and AI-powered systems."}],["$","meta","4",{"property":"og:image","content":"https://sanyamk23.github.io/og.jpg"}],["$","meta","5",{"property":"og:image:width","content":"1200"}],["$","meta","6",{"property":"og:image:height","content":"630"}],["$","meta","7",{"property":"og:type","content":"website"}],["$","meta","8",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","9",{"name":"twitter:title","content":"Sanyam Kumat"}],["$","meta","10",{"name":"twitter:description","content":"I build scalable cloud-native backends, APIs, and AI-powered systems."}],["$","meta","11",{"name":"twitter:image","content":"https://sanyamk23.github.io/og.jpg"}],["$","meta","12",{"name":"twitter:image:width","content":"1200"}],["$","meta","13",{"name":"twitter:image:height","content":"630"}],["$","link","14",{"rel":"icon","href":"/icon-m.svg","type":"image/svg+xml"}],["$","link","15",{"rel":"icon","href":"/favicon.ico","sizes":"48x48"}],["$","link","16",{"rel":"apple-touch-icon","href":"/apple-touch-icon.png"}],["$","$L49","17",{}]],"error":null,"digest":"$undefined"}
