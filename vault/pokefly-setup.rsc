ull]}]]}],["$","$L7",null,{"onMount":true,"delay":0.2,"y":12,"children":[["$","p",null,{"className":"head-lede","children":"A simulated fly brain, 2,000 spiking neurons, playing Pokemon Red on your own PC. Where your ROM goes, why you train the brain first, and what each part of the brain does."}],null]}]]}],["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/pokefly-setup.webp","width":1200,"height":800,"alt":"","fetchPriority":"high","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}]]}]]}],["$","div",null,{"className":"sheet","children":[["$","canvas",null,{"className":"seam","data-seam":"#F5F2EA","aria-hidden":"true"}],["$","div",null,{"className":"pad sheet-in","children":[["$","article",null,{"className":"read guide","children":["$","div",null,{"children":[["$","div","0",{"className":"mt-6 rounded-xl border border-accent/30 bg-accent/10 px-5 py-4 leading-[1.7] text-ink","children":"Important, before you start: you need your own Pokemon Red ROM. I can't link one or send you one, because sharing ROMs is illegal. Google how to get one. Nothing in Pokefly downloads a ROM either."}],["$","p","1",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Pokefly is a simulated fly brain that plays Pokemon Red. It watches the Game Boy screen and presses the buttons itself. Untrained, it left Red's house 0 times out of 10. After training, the same fly left 10 out of 10. Here's how to run it on your own machine."}],["$","h2","2",{"className":"mt-12 t-h3 text-ink","children":"What you need"}],["$","ul","3",{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"A Windows PC with Python 3.13. The commands below are for PowerShell."}]]}],["$","li","1",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Your own Pokemon Red ROM. It's a .gb file, about 1 MB."}]]}],["$","li","2",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Around an hour for training. It took 44 minutes on my PC."}]]}]]}],["$","h2","4",{"className":"mt-12 t-h3 text-ink","children":"Step 1: Get the code"}],"$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}]}],"$L25"]}]]}],"$L26"]
