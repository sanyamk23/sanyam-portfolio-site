26:["$","p","11",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Chrome opens in its own window. The first time, you log in to Instagram there yourself, and Claude never sees your password. Reels play at normal speed, 25 a batch at about two minutes each."}]
27:["$","h2","12",{"className":"mt-12 t-h3 text-ink","children":"What it does"}]
28:["$","ol","13",{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[1,"."]}],["$","span",null,{"children":"Scrolls your Saved tab and collects every post. It leaves out your own posts, and anything that plainly isn't a technique, like memes, once you OK the list."}]]}],["$","li","1",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[2,"."]}],["$","span",null,{"children":"Plays every reel with the sound on, transcribes it with Whisper, and saves a still each time the screen changes, so Claude reads the code exactly as it was on screen."}]]}],["$","li","2",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[3,"."]}],["$","span",null,{"children":"Cuts the fluff, flags reels that keep their steps behind \"comment GUIDE\", and merges a trick six creators posted into one version with the best details from each."}]]}],["$","li","3",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[4,"."]}],["$","span",null,{"children":"Checks everything it keeps against the official docs, and runs code, commands, and config in a sandbox folder when it can."}]]}],["$","li","4",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[5,"."]}],["$","span",null,{"children":"Reads how you work, like your stack, CLAUDE.md, hooks, skills, recent commits, and other projects, then puts each technique where it belongs: this project, another one of yours, or a library for later."}]]}],["$","li","5",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[6,"."]}],["$","span",null,{"children":"Hands you a plan you can read in two minutes, with three to seven things to do first, why each one matters for you, how long it takes, and which reels it came from. Say \"do 1 to 3\" and it builds them."}]]}]]}]
29:["$","h2","14",{"className":"mt-12 t-h3 text-ink","children":"Watch it work"}]
