d:[["$","header",null,{"className":"head pad","children":[["$","canvas",null,{"className":"head-code","id":"head-code","aria-hidden":"true"}],["$","div",null,{"className":"head-grid split","children":[["$","div",null,{"className":"head-text","children":[["$","div",null,{"className":"head-meta","children":[["$","$L8",null,{"href":"/vault","aria-label":"Back to the Vault","children":"← /vault"}],["$","span",null,{"children":"Building"}],["$","span",null,{"children":["6 min"," read"]}]]}],["$","h1",null,{"className":"head-title","data-head":true,"aria-label":"20 security holes in your vibe-coded app","children":[["$","span","0",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"20"}]," "]}],["$","span","1",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"security"}]," "]}],["$","span","2",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"holes"}]," "]}],["$","span","3",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"in"}]," "]}],["$","span","4",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"your"}]," "]}],["$","span","5",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"vibe-coded"}]," "]}],["$","span","6",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"app"}],null]}]]}],["$","$L7",null,{"onMount":true,"delay":0.2,"y":12,"children":[["$","p",null,{"className":"head-lede","children":"The 20 holes that show up in almost every vibe-coded app, what each one costs you, and the exact prompt to paste into Claude or Cursor to audit your own codebase."}],null]}]]}],["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/20-security-holes-vibe-coded-app.webp","width":1200,"height":800,"alt":"","fetchPriority":"high","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}]]}]]}],["$","div",null,{"className":"sheet","children":[["$","canvas",null,{"className":"seam","data-seam":"#F5F2EA","aria-hidden":"true"}],["$","div",null,{"className":"pad sheet-in","children":[["$","article",null,{"className":"read guide","children":["$","div",null,{"children":[["$","p","0",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Vibe coding gets you a working app in a weekend. It also ships the same security holes over and over, because the model is trying to make the thing work and nobody asked it to make the thing safe. These are the 20 that show up in almost every one. Copy this whole page, paste it into Claude or Cursor with the prompt at the bottom, and fix what it finds."}],["$","h2","1",{"className":"mt-12 t-h3 text-ink","children":"1. Committing your .env to GitHub"}],["$","p","2",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Secrets in a public repo get scraped by bots within minutes of the push, and deleting the file later doesn't help because git keeps the history. The fix: add .env to .gitignore, keep secrets server side, and rotate every key that ever touched a commit."}],["$","h2","3",{"className":"mt-12 t-h3 text-ink","children":"2. Putting real API keys in your frontend code"}],["$","p","4",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Anything in your JS bundle ships to the browser. Prefixes like NEXT_PUBLIC_ and EXPO_PUBLIC_ mean public, and anyone can read them in devtools. The fix: only publishable keys go client side. Real keys live in edge functions or your backend."}],["$","h2","5",{"className":"mt-12 t-h3 text-ink","children":"3. Leaving row level security off"}],["$","p","6",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"On Supabase or Firebase with RLS disabled, your anon key is a master key. Anyone who pulls it out of your bundle can read and write every user's rows. The fix: RLS on by default, policies scoped to auth.uid(), and test them with a second account."}],["$","h2","7",{"className":"mt-12 t-h3 text-ink","children":"4. Checking permissions in the frontend"}],["$","p","8",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"if (user.isAdmin) in React stops nobody. A user edits the response, calls your API directly, or just flips a variable in devtools. The fix: every permission check runs on the server. The frontend decides what to show and the server decides what's allowed."}],"$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a"]}]}],"$L3b"]}]]}],"$L3c"]
3d:I[6502,["619","static/chunks/619-ba102abea3e3d0e4.js","506","static/chunks/506-51bde6540850d248.js","867","static/chunks/app/vault/%5Bslug%5D/page-cbc8dd1a06312276.js"],"CopyButton"]
17:["$","h2","9",{"className":"mt-12 t-h3 text-ink","children":"5. No rate limiting on your endpoints"}]
18:["$","p","10",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"One script hammering your login brute-forces passwords. One script hammering your AI route runs your bill into four figures overnight. The fix: per-user and per-IP throttles on every login, signup, and expensive route."}]
19:["$","h2","11",{"className":"mt-12 t-h3 text-ink","children":"6. Building SQL queries with string concatenation"}]
1a:["$","p","12",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Splicing user input into a query string lets someone close your quote and append their own SQL. The fix: parameterized queries or an ORM. Never build a query with string interpolation."}]
1b:["$","h2","13",{"className":"mt-12 t-h3 text-ink","children":"7. No server-side input validation"}]
1c:["$","p","14",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Form validation is a UX feature. Anyone can skip your form and POST directly to the endpoint with a negative quantity or a 10MB \"email.\" The fix: validate and sanitize on the server too, with a schema library like Zod."}]
1d:["$","h2","15",{"className":"mt-12 t-h3 text-ink","children":"8. Rendering user content as raw HTML"}]
1e:["$","p","16",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"dangerouslySetInnerHTML on user-submitted text lets someone inject a script that runs in other users' browsers and steals their sessions. The fix: render user content as text. If you must render HTML, sanitize it with DOMPurify first."}]
1f:["$","h2","17",{"className":"mt-12 t-h3 text-ink","children":"9. Storing passwords in plaintext"}]
20:["$","p","18",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"One database leak exposes every account on your app, plus every other site where those users reused the password. The fix: use your auth provider's hashing, bcrypt or argon2. Don't write your own."}]
21:["$","h2","19",{"className":"mt-12 t-h3 text-ink","children":"10. Keeping auth tokens in localStorage"}]
22:["$","p","20",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Any XSS script on your page can read localStorage and walk off with a live session token. The fix: httpOnly cookies on web, secure storage like expo-secure-store on native."}]
23:["$","h2","21",{"className":"mt-12 t-h3 text-ink","children":"11. An admin panel with no auth on it"}]
24:["$","p","22",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"/admin protected by nothing but the fact that you haven't linked to it. Same for the /debug route that dumps your environment variables. The fix: auth-gate every internal route and strip debug endpoints out of production builds."}]
25:["$","h2","23",{"className":"mt-12 t-h3 text-ink","children":"12. CORS set to star"}]
26:["$","p","24",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Access-Control-Allow-Origin: * lets any site on the internet call your API with a logged-in user's credentials attached. The fix: allowlist your own origins and nothing else."}]
27:["$","h2","25",{"className":"mt-12 t-h3 text-ink","children":"13. No email verification on signup"}]
28:["$","p","26",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Unverified signups mean fake accounts, spam, and takeover flows that let someone claim an address they don't own. The fix: verify the email before granting access to anything real."}]
29:["$","h2","27",{"className":"mt-12 t-h3 text-ink","children":"14. Predictable IDs with no ownership check"}]
2a:["$","p","28",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Sequential IDs are fine. Sequential IDs with no check that the record belongs to the requester means someone changes /order/1001 to /order/1002 and reads a stranger's data. The fix: on every fetch and every mutation, confirm the resource belongs to the user asking for it."}]
2b:["$","h2","29",{"className":"mt-12 t-h3 text-ink","children":"15. Saving the whole request body on updates"}]
2c:["$","p","30",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"An update endpoint that writes whatever JSON it receives lets a user add \"role\": \"admin\" or \"is_premium\": true to their own profile update. The fix: allowlist the exact fields a user can set and ignore everything else in the body."}]
2d:["$","h2","31",{"className":"mt-12 t-h3 text-ink","children":"16. Webhooks with no signature check"}]
2e:["$","p","32",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Your Stripe handler trusts any POST that looks right. Someone sends a fake payment_succeeded and unlocks premium for free. The fix: verify the signature against your webhook secret before you touch the payload."}]
2f:["$","h2","33",{"className":"mt-12 t-h3 text-ink","children":"17. Stack traces in production"}]
30:["$","p","34",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Verbose errors leak file paths, table names, and library versions, which is a free map for anyone probing your app. The fix: generic error messages to users. Real details go to your logs."}]
31:["$","h2","35",{"className":"mt-12 t-h3 text-ink","children":"18. Never updating your dependencies"}]
32:["$","p","36",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Packages you installed a year ago have public CVEs with exploit code already written. The fix: run npm audit, turn on Dependabot, and patch on a schedule instead of when something breaks."}]
33:["$","h2","37",{"className":"mt-12 t-h3 text-ink","children":"19. No password strength or breach check"}]
34:["$","p","38",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Without a minimum length and a breached-password check, password123 becomes a live account on your app. The fix: set a minimum length and enable the leaked-password check your auth provider already ships. Supabase has one built in."}]
35:["$","h2","39",{"className":"mt-12 t-h3 text-ink","children":"20. File uploads with no validation"}]
36:["$","p","40",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Accepting any file lets someone upload a script and find a way to get your server to serve or execute it. The fix: check type and size, store uploads outside the web root or in object storage, and never execute an uploaded file."}]
37:["$","h2","41",{"className":"mt-12 t-h3 text-ink","children":"The prompt to paste with it"}]
38:["$","p","42",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Copy everything above, put this on top, and send the whole thing to Claude or Cursor:"}]
39:["$","div","43",{"className":"mt-5","children":[["$","div",null,{"className":"mb-2 flex items-center justify-between gap-4","children":[["$","span",null,{"className":"font-mono text-[12px] text-ink-dim","children":"Copy and paste"}],["$","$L3d",null,{"text":"Audit my codebase against the 20 issues below. For each one, tell me whether my code has the problem, cite the specific file and line, and give me the fix. Don't change anything yet, just report first."}]]}],["$","pre",null,{"className":"rounded-xl bg-[#0a1020] p-5 font-mono text-[13px] leading-[1.7] text-[#e4e9f5] overflow-x-auto","children":["$","code",null,{"children":"Audit my codebase against the 20 issues below. For each one, tell me whether my code has the problem, cite the specific file and line, and give me the fix. Don't change anything yet, just report first."}]}]]}]
3a:["$","div","44",{"className":"mt-6 rounded-xl border border-accent/30 bg-accent/10 px-5 py-4 leading-[1.7] text-ink","children":"Save this one. Run the audit before you ship, then again after every big feature. It takes twenty minutes."}]
