a:[["$","header",null,{"className":"head pad","children":[["$","canvas",null,{"className":"head-code","id":"head-code","aria-hidden":"true"}],["$","div",null,{"className":"head-grid split","children":[["$","div",null,{"className":"head-text","children":[["$","div",null,{"className":"head-meta","children":[["$","$L8",null,{"href":"/vault","aria-label":"Back to the Vault","children":"← /vault"}],["$","span",null,{"children":"AI"}],["$","span",null,{"children":["5 min"," read"]}]]}],["$","h1",null,{"className":"head-title","data-head":true,"aria-label":"Build a RAG agent that answers from your own data","children":[["$","span","0",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"Build"}]," "]}],["$","span","1",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"a"}]," "]}],["$","span","2",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"RAG"}]," "]}],["$","span","3",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"agent"}]," "]}],["$","span","4",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"that"}]," "]}],["$","span","5",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"answers"}]," "]}],["$","span","6",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"from"}]," "]}],["$","span","7",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"your"}]," "]}],["$","span","8",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"own"}]," "]}],["$","span","9",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"data"}],null]}]]}],["$","$L7",null,{"onMount":true,"delay":0.2,"y":12,"children":[["$","p",null,{"className":"head-lede","children":"The retrieval, grounding and fallback rules I use when an agent has to answer from private documents instead of guessing. Chunking, citations, and what to do when nothing relevant comes back."}],null]}]]}],["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/ai-second-brain-claude-obsidian.webp","width":1200,"height":800,"alt":"","fetchPriority":"high","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}]]}]]}],["$","div",null,{"className":"sheet","children":[["$","canvas",null,{"className":"seam","data-seam":"#F5F2EA","aria-hidden":"true"}],["$","div",null,{"className":"pad sheet-in","children":[["$","article",null,{"className":"read guide","children":["$","div",null,{"children":[["$","p","0",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"A retrieval agent is only as good as the rule it follows when retrieval fails. Most demos skip that part, and it is the part users hit first. This is the shape I use for agents that answer from private documents."}],["$","h2","1",{"className":"mt-12 t-h3 text-ink","children":"Step 1: Chunk by meaning, not by size"}],["$","p","2",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Splitting every 1,000 characters cuts sentences and tables in half. Split on headings and paragraphs first, then merge small pieces up to a size limit. Keep the document title and section heading attached to every chunk, so a chunk still makes sense on its own."}],["$","h2","3",{"className":"mt-12 t-h3 text-ink","children":"Step 2: Store the source with the vector"}],["$","p","4",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Every chunk carries its document id, section and page or URL. You need this twice: to show citations, and to debug a bad answer by seeing exactly which chunks were retrieved."}],["$","h2","5",{"className":"mt-12 t-h3 text-ink","children":"Step 3: Retrieve wide, then rerank"}],["$","p","6",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Pull a generous top-k by vector similarity, then rerank or filter down to the few chunks that actually go in the prompt. Metadata filters (tenant, document type, date) belong in the retrieval query, not in the prompt."}],["$","h2","7",{"className":"mt-12 t-h3 text-ink","children":"Step 4: Ground the answer in the prompt"}],["$","p","8",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Tell the model to answer only from the supplied context, to cite the chunk ids it used, and to say so when the context does not contain the answer."}],["$","div","9",{"className":"mt-5","children":[["$","div",null,{"className":"mb-2 flex items-center justify-between gap-4","children":[["$","span",null,{"className":"font-mono text-[12px] text-ink-dim","children":"Copy and paste"}],["$","$L17",null,{"text":"SYSTEM = \"\"\"Answer using only the context below.\nCite chunk ids like [c3] after each claim.\nIf the context does not contain the answer, reply exactly:\n\"I could not find that in the documents.\"\nNever use outside knowledge.\"\"\"\n\ndef build_prompt(question, chunks):\n    ctx = \"\\n\\n\".join(f\"[{c.id}] {c.text}\" for c in chunks)\n    return f\"{SYSTEM}\\n\\nContext:\\n{ctx}\\n\\nQuestion: {question}\""}]]}],["$","pre",null,{"className":"rounded-xl bg-[#0a1020] p-5 font-mono text-[13px] leading-[1.7] text-[#e4e9f5] overflow-x-auto","children":["$","code",null,{"children":"SYSTEM = \"\"\"Answer using only the context below.\nCite chunk ids like [c3] after each claim.\nIf the context does not contain the answer, reply exactly:\n\"I could not find that in the documents.\"\nNever use outside knowledge.\"\"\"\n\ndef build_prompt(question, chunks):\n    ctx = \"\\n\\n\".join(f\"[{c.id}] {c.text}\" for c in chunks)\n    return f\"{SYSTEM}\\n\\nContext:\\n{ctx}\\n\\nQuestion: {question}\""}]}]]}],["$","h2","10",{"className":"mt-12 t-h3 text-ink","children":"Step 5: Decide the fallback before launch"}],["$","p","11",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"If the best similarity score is under a threshold, skip generation and return the fallback line, or hand off to a human. A fixed refusal is better than a fluent wrong answer."}],["$","h2","12",{"className":"mt-12 t-h3 text-ink","children":"Step 6: Log every retrieval"}],["$","p","13",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Store the question, the chunk ids, the scores and the final answer. When someone says the agent was wrong, you can tell in a minute whether retrieval or generation failed, and fix the right layer."}],["$","h2","14",{"className":"mt-12 t-h3 text-ink","children":"What I would test first"}],["$","p","15",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Ten questions whose answers are in the documents, ten whose answers are not, and five that are phrased badly. The second group tells you more about your agent than the first."}]]}]}],"$L21"]}]]}],"$L22"]
