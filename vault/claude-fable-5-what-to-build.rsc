t did that. Some of the real ones:"}],["$","ul","3",{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Three playable games from three one-line prompts, built by Wharton professor Ethan Mollick in Claude Code: a Snake clone, a lantern-lit tunnel maze, and a game built on Rilke's poetry."}]]}],["$","li","1",{"className":"flex gap-3 leading-[1.7] text-ink","children":["$L17","$L18"]}],"$L19","$L1a","$L1b","$L1c","$L1d"]}],"$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b"]}]}],"$L2c"]}]]}],"$L2d"]
