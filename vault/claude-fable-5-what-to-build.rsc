20:["$","p","6",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"The pattern is the same every time: someone described a thing and then the thing existed. If you make content, run something, or just have a list of tools you always wished existed, this is where to point it."}]
21:["$","h2","7",{"className":"mt-12 t-h3 text-ink","children":"If you make content"}]
22:["$","ul","8",{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"A personal analytics dashboard that pulls every platform onto one screen, so you stop opening five apps to see how a post did."}]]}],["$","li","1",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"An agent that takes one video or article and reformats it for every platform on its own while you sleep."}]]}],["$","li","2",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"Interactive toys as content. A playable mini-game tied to your topic gets shared far more than another static post, and people built full games from a single sentence."}]]}],["$","li","3",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"A second brain over everything you've ever made, so you can ask what your best hooks had in common and get a real answer instead of a guess."}]]}]]}]
23:["$","h2","9",{"className":"mt-12 t-h3 text-ink","children":"If you run a business or a brand"}]
24:["$","ul","10",{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"A real landing page at designer quality, from a description or even a screenshot of a page you already like."}]]}],["$","li","1",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"The internal tools you keep putting off: a lightweight CRM, a booking flow, a dashboard your team will actually open."}]]}],["$","li","2",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"The big migration or cleanup nobody wants to touch. This is the Stripe use case, scaled down to your mess."}]]}],["$","li","3",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"A custom app for one specific job, instead of paying monthly for bloated software that does that one thing plus fifty you never use."}]]}]]}]
25:["$","h2","11",{"className":"mt-12 t-h3 text-ink","children":"Just for you"}]
26:["$","ul","12",{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"A wall-display dashboard for your kitchen: calendar, weather, whatever you want on the screen. Someone built one for a 77-inch OLED."}]]}],["$","li","1",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"An app to run your own house: your music, your lights, your routines, in one place."}]]}],["$","li","2",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"aria-hidden":true,"className":"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":"The weird passion project you'd never pay a developer for. An explorable universe, a game only you and your friends will play, a tool that kills one tiny daily annoyance."}]]}]]}]
27:["$","h2","13",{"className":"mt-12 t-h3 text-ink","children":"How to actually use it"}]
28:["$","ol","14",{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[1,"."]}],["$","span",null,{"children":"Use it inside an agent, not a chat box. Claude Code, or a similar harness, is where Fable earns its price. That's what lets it run for hours instead of one message."}]]}],["$","li","1",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[2,"."]}],["$","span",null,{"children":"Describe the outcome, not the steps. Its goal mode lets you state an end result and let it iterate until it gets there. You don't need to know how it's built."}]]}],["$","li","2",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[3,"."]}],["$","span",null,{"children":"Turn the effort up for the hard stuff. Higher effort means it thinks longer and pushes further before it stops."}]]}],["$","li","3",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[4,"."]}],["$","span",null,{"children":"Run jobs in parallel. People handed it nine separate workstreams in one night. If you have a backlog, line up the prompts and let them run at once."}]]}],["$","li","4",{"className":"flex gap-3 leading-[1.7] text-ink","children":[["$","span",null,{"className":"font-mono text-sm text-accent-soft","children":[5,"."]}],["$","span",null,{"children":"Keep a cheaper model open for the small stuff and save Fable for the jobs that earn it."}]]}]]}]
29:["$","div","15",{"className":"mt-4","children":["$","a",null,{"href":"https://platform.claude.com/docs/en/build-with-claude/prompt-engineering/prompting-claude-fable-5","target":"_blank","rel":"noopener noreferrer","className":"inline-flex w-fit items-center gap-1.5 rounded-xl border border-accent/40 bg-accent/10 px-5 py-2.5 text-sm font-semibold text-accent-soft transition-colors hover:bg-accent/20 hover:text-accent","children":["Anthropic's prompting guide for Fable 5"," ",["$","span",null,{"aria-hidden":true,"children":"↗"}]]}]}]
2a:["$","h2","16",{"className":"mt-12 t-h3 text-ink","children":"The bottleneck now"}]
2b:["$","p","17",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"The gap between people who can build things and people who can only picture them just got a lot smaller. Having an idea and shipping it used to be two different skills, and Fable erases most of the distance between them. So the bottleneck is no longer the code, it's whether you have a list of things worth building. If you don't, start the list."}]
