d:[["$","header",null,{"className":"head pad","children":[["$","canvas",null,{"className":"head-code","id":"head-code","aria-hidden":"true"}],["$","div",null,{"className":"head-grid split","children":[["$","div",null,{"className":"head-text","children":[["$","div",null,{"className":"head-meta","children":[["$","$L8",null,{"href":"/vault","aria-label":"Back to the Vault","children":"← /vault"}],["$","span",null,{"children":"Shipping"}],["$","span",null,{"children":["9 min"," read"]}]]}],["$","h1",null,{"className":"head-title","data-head":true,"aria-label":"20 things to do before you launch your app","children":[["$","span","0",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"20"}]," "]}],["$","span","1",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"things"}]," "]}],["$","span","2",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"to"}]," "]}],["$","span","3",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"do"}]," "]}],["$","span","4",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"before"}]," "]}],["$","span","5",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"you"}]," "]}],["$","span","6",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"launch"}]," "]}],["$","span","7",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"your"}]," "]}],["$","span","8",{"children":[["$","span",null,{"className":"word","aria-hidden":"true","children":"app"}],null]}]]}],["$","$L7",null,{"onMount":true,"delay":0.2,"y":12,"children":[["$","p",null,{"className":"head-lede","children":"The housekeeping that decides week one: store rejections, spam folder signups, surprise bills, and the submission day checklist, plus the prompt that audits your app against all twenty."}],null]}]]}],["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/20-things-before-you-launch.webp","width":1200,"height":800,"alt":"","fetchPriority":"high","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}]]}]]}],["$","div",null,{"className":"sheet","children":[["$","canvas",null,{"className":"seam","data-seam":"#F5F2EA","aria-hidden":"true"}],["$","div",null,{"className":"pad sheet-in","children":[["$","article",null,{"className":"read guide","children":["$","div",null,{"children":[["$","p","0",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Your app is done. The features work, the screens look right, and you're maybe a week from putting it in the stores. This list is everything else: the twenty pieces of housekeeping that decide whether week one goes smoothly or turns into rejections, dead signups, and a bill you didn't see coming."}],["$","p","1",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Every item ends with what to do about it. If you'd rather not check them by hand, paste this whole page into Claude with the prompt at the bottom and it'll walk your app through all twenty."}],["$","h2","2",{"className":"mt-12 t-h3 text-ink","children":"1. Run a real beta first"}],["$","p","3",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Google Play won't let you skip this one. A personal Play account created after November 2023 must run a closed test with at least 12 testers opted in for 14 consecutive days before you can even apply for production access, and Google then reviews that application, which takes about another week. The 14 days must be continuous: if your opted-in count dips below 12, the clock resets. On iOS, TestFlight gives you 10,000 external testers through a public link."}],["$","p","4",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Even without Google's rule you'd want this. Day one bugs become day one one-star reviews, and your first ten reviews set the tone of your listing for months."}],["$","p","5",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: run a TestFlight or closed-track beta at least two weeks before launch. Start the Play Console clock far earlier than feels necessary."}],"$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e","$L4f","$L50","$L51","$L52","$L53","$L54","$L55"]}]}],"$L56"]}]]}],"$L57"]
58:I[6502,["619","static/chunks/619-ba102abea3e3d0e4.js","506","static/chunks/506-51bde6540850d248.js","867","static/chunks/app/vault/%5Bslug%5D/page-cbc8dd1a06312276.js"],"CopyButton"]
17:["$","h2","6",{"className":"mt-12 t-h3 text-ink","children":"2. Wire up crash reporting"}]
18:["$","p","7",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Ship without Sentry or Crashlytics and your crash reporter is your review section. You find out about launch day crashes days late, from angry strangers, with zero stack traces. Add a privacy friendly analytics tool like TelemetryDeck or PostHog in the same pass, because if you can't see the screen where users quit, you can't fix week one."}]
19:["$","p","8",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: wire Sentry or Crashlytics during the beta, point analytics at the core loop, and hold yourself to 99% crash-free sessions from day one."}]
1a:["$","h2","9",{"className":"mt-12 t-h3 text-ink","children":"3. Build the delete-account button"}]
1b:["$","p","10",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"If your app has sign-up, both stores will reject you for a missing delete button. Apple guideline 5.1.1(v) requires any app with account creation to offer in-app account deletion. It's been in force since 2022 and it's still one of the top rejections. Google goes further: in-app deletion plus a public web link that works without reinstalling the app, declared in your Data Safety form."}]
1c:["$","p","11",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: build a delete-account flow with a two-step confirm, a server-side cascade that removes the data everywhere it lives, and the public web deletion link for Play."}]
1d:["$","h2","12",{"className":"mt-12 t-h3 text-ink","children":"4. Host your privacy policy"}]
1e:["$","p","13",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Apple rejected 1.9 million apps last year, and a dead privacy policy link is one of the cheapest ways to join them. Both stores require a live hosted privacy policy URL. A 404 is an automatic rejection."}]
1f:["$","p","14",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: host the policy on your own domain, link it in both store listings, and click the link from a device that has never seen it before you submit."}]
20:["$","h2","15",{"className":"mt-12 t-h3 text-ink","children":"5. Declare what your SDKs collect"}]
21:["$","p","16",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"The App Privacy label and the Play Data Safety form both want the data your SDKs collect, Crashlytics, analytics, and ads included, even when it never touches your servers. Google runs an automated scan that catches undeclared device IDs. Apple has also required privacy manifests for common SDKs since May 2024."}]
22:["$","p","17",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: write down every SDK in the app, fill the labels from that list, and re-check the form each time you add one."}]
23:["$","h2","18",{"className":"mt-12 t-h3 text-ink","children":"6. Set up SPF, DKIM, and DMARC"}]
24:["$","p","19",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Your app can be perfect and still die in the spam folder. Since 2024, Gmail and Yahoo enforce email authentication: SPF and DKIM for every sender, aligned SPF, DKIM, and DMARC for bulk senders, and outright rejection for mail that fails."}]
25:["$","p","20",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: send auth email from your own domain through Resend or Postmark and add SPF, DKIM, and DMARC records to your DNS."}]
26:["$","h2","21",{"className":"mt-12 t-h3 text-ink","children":"7. Test signup with a fresh Gmail"}]
27:["$","p","22",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"DNS records that look right don't mean your mail lands. If the verification code goes to spam, your activation funnel is dead, and users blame the app."}]
28:["$","p","23",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: create a brand-new Gmail account, run your real signup flow, and watch where the verification email lands. Repeat with an Outlook address if you can stand it."}]
29:["$","h2","24",{"className":"mt-12 t-h3 text-ink","children":"8. Set hard spend caps on every API"}]
2a:["$","p","25",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"One stolen Gemini API key ran up $82,000 in 48 hours. A retry loop billed another team $1.6 million over a weekend. Billing alerts fire after the damage, so an alert alone protects nothing."}]
2b:["$","p","26",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: set hard caps at every provider that offers them, and put per-user rate limits on any endpoint that costs you money per call."}]
2c:["$","h2","27",{"className":"mt-12 t-h3 text-ink","children":"9. Watch your LLM credit balance"}]
2d:["$","p","28",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Prepaid LLM credits run out without a sound. OpenAI's API starts returning 429 insufficient_quota errors the moment the balance is spent, and Anthropic's prepaid plans fail the same way. The first symptom is your app's AI features erroring in production, and the second is the reviews about it."}]
2e:["$","p","29",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: set balance alerts on every prepaid credit pool, and know before launch week whether your provider fails hard or throttles when the balance hits zero."}]
2f:["$","h2","30",{"className":"mt-12 t-h3 text-ink","children":"10. Get off the pausing free tier"}]
30:["$","p","31",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Supabase free projects pause after about seven days of inactivity, which kills your demo mid-launch week. Render's free web services spin down after 15 minutes without a request and take 30 to 60 seconds to wake up, and a first-time visitor who waits that long is gone."}]
31:["$","p","32",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: move the database and the host off any tier that pauses or sleeps before launch week. Don't wait for the first dead demo."}]
32:["$","h2","33",{"className":"mt-12 t-h3 text-ink","children":"11. Rehearse a database restore"}]
33:["$","p","34",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"A backup you've never restored is a file you hope works. In 2017 a GitLab engineer ran a cleanup command on the wrong database and erased production. GitLab had five backup mechanisms: daily snapshots, S3 uploads, replication, manual archives, streaming logs. Every one of them had failed and nobody knew, because nobody had tried a restore. The only usable copy was a manual backup someone happened to take six hours earlier, and six hours of users' issues and merge requests were gone for good."}]
34:["$","p","35",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"That was a company full of infrastructure engineers. Your solo project has one backup mechanism and the same odds."}]
35:["$","p","36",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: restore your latest backup into a scratch instance, point a dev build at it, and check that real data comes back. Put the steps in a doc while they're fresh."}]
36:["$","h2","37",{"className":"mt-12 t-h3 text-ink","children":"12. Ship a kill switch"}]
37:["$","p","38",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"When your launch build breaks, app review means it stays broken for days, and you can't retrofit a kill switch onto binaries already in the wild. Ship v1.0 with remote config and a minimum-supported-version check so you can turn a broken feature off without a review cycle."}]
38:["$","p","39",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: put remote config and a min-version gate in the first build, and test flipping a flag off before you need to."}]
39:["$","h2","40",{"className":"mt-12 t-h3 text-ink","children":"13. Ship an over-the-air hotfix path"}]
3a:["$","p","41",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"The kill switch turns a broken feature off. The hotfix path fixes it. On Expo or React Native, EAS Update pushes JavaScript fixes over the air in minutes instead of the days a store review takes."}]
3b:["$","p","42",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: set up the OTA update channel and push one test update through it before launch, so your first real push isn't during an emergency."}]
3c:["$","h2","43",{"className":"mt-12 t-h3 text-ink","children":"14. Move support email to your own domain"}]
3d:["$","p","44",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"A support@ address on your own domain instead of your personal Gmail, and a live support URL in the App Store listing, since a dead one is a metadata rejection. While you're in there, remember your app name: App Store Connect holds a reserved name for 90 days and gives you zero trademark protection."}]
3e:["$","p","45",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: set up domain email, put up a real support page, and reserve the name late enough that you ship inside the 90-day window."}]
3f:["$","h2","46",{"className":"mt-12 t-h3 text-ink","children":"15. Use your agent's address, not your home"}]
40:["$","p","47",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Since February 2025, monetizing in the EU requires trader status: your address, phone number, and email published on your store page. Apple removed around 135,000 apps that didn't comply. If you registered with your home address, your home address is what gets published."}]
41:["$","p","48",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: form the entity and use a registered agent address before launch. It's the cheapest privacy you'll ever buy."}]
42:["$","h2","49",{"className":"mt-12 t-h3 text-ink","children":"16. Put a demo account in the review notes"}]
43:["$","p","50",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"A missing login is a guideline 2.1 rejection, and it's the most common avoidable one. While you're in the listing, check the screenshots too: showing features that don't exist is a 2.3 rejection."}]
44:["$","p","51",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: create a demo account with realistic data, verify the credentials work on a clean device, and paste them into the review notes."}]
45:["$","h2","52",{"className":"mt-12 t-h3 text-ink","children":"17. Test Restore Purchases after a reinstall"}]
46:["$","p","53",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"The user who pays, drops their phone in a lake, and reinstalls on a new device is the user who leaves the one-star review when their subscription doesn't come back. Apple also checks during review: guideline 3.1.1 requires a restore mechanism for any subscription or non-consumable purchase, and a paywall without one gets rejected. AI generated paywalls fail this one on repeat, because the model builds the purchase flow and skips the boring compliance part."}]
47:["$","p","54",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"A button labeled Restore isn't enough either. It has to call StoreKit, pull the user's transactions, and re-grant the entitlement."}]
48:["$","p","55",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: buy with a sandbox account, delete the app, reinstall, and hit Restore Purchases on a real device. Disclose auto-renewal terms on the paywall while you're at it."}]
49:["$","h2","56",{"className":"mt-12 t-h3 text-ink","children":"18. Swap the test payment key for production"}]
4a:["$","p","57",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Shipping the sandbox key in the release build is a classic miss on the RevenueCat launch checklist. Purchases work for you all through testing, then fail for every real customer on day one."}]
4b:["$","p","58",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: check the build config for the production key, then make one real purchase with a real card and refund it."}]
4c:["$","h2","59",{"className":"mt-12 t-h3 text-ink","children":"19. Turn on phased release"}]
4d:["$","p","60",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Phased release rolls your update out to auto-update users over seven days at fixed percentages: 1%, 2%, 5%, 10%, 20%, 50%, then everyone. A bad build hurts 1% of your ratings instead of all of them, and you can pause the rollout for up to 30 days while you fix it. Pair it with \"Manually release this version\" so approval doesn't launch you by surprise at 3am."}]
4e:["$","p","61",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: check both boxes before you submit. And hold the rating prompt: don't fire it on first open, ask around day ten after a success moment."}]
4f:["$","h2","62",{"className":"mt-12 t-h3 text-ink","children":"20. Never submit on a Friday"}]
50:["$","p","63",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Apple reviews 90% of submissions within 24 hours, but review staffing thins on weekends, and a submission that goes in Friday evening can sit until Monday. Worse, a launch crash on a Saturday means two days of one-star reviews while your fix waits in the same thin queue."}]
51:["$","p","64",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Do: submit Monday to Wednesday, and run items 16 through 20 as a literal checklist the day you do."}]
52:["$","h2","65",{"className":"mt-12 t-h3 text-ink","children":"Paste this into Claude"}]
53:["$","p","66",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"Give your AI this page plus access to your codebase, or just answer its questions about your setup, and let it run the audit for you."}]
54:["$","div","67",{"className":"mt-5","children":[["$","div",null,{"className":"mb-2 flex items-center justify-between gap-4","children":[["$","span",null,{"className":"font-mono text-[12px] text-ink-dim","children":"Copy and paste"}],["$","$L58",null,{"text":"I'm about to launch my app. Below is a twenty-item pre-launch checklist. Go through it one item at a time against my codebase and what I tell you about my setup.\n\nFor each item, tell me: pass, fail, or can't tell. If it's a fail, show me the specific file, setting, or missing piece, then give me the fix. If you can't tell from the code, list the exact things I need to check by hand (store console settings, DNS records, provider dashboards) and how to check each one.\n\nThen rank the failures by how badly each would hurt me in week one and give me the fix order. Start with items 6 through 11, since every one of those fails silently.\n\n[paste the twenty items here]"}]]}],["$","pre",null,{"className":"rounded-xl bg-[#0a1020] p-5 font-mono text-[13px] leading-[1.7] text-[#e4e9f5] overflow-x-auto","children":["$","code",null,{"children":"I'm about to launch my app. Below is a twenty-item pre-launch checklist. Go through it one item at a time against my codebase and what I tell you about my setup.\n\nFor each item, tell me: pass, fail, or can't tell. If it's a fail, show me the specific file, setting, or missing piece, then give me the fix. If you can't tell from the code, list the exact things I need to check by hand (store console settings, DNS records, provider dashboards) and how to check each one.\n\nThen rank the failures by how badly each would hurt me in week one and give me the fix order. Start with items 6 through 11, since every one of those fails silently.\n\n[paste the twenty items here]"}]}]]}]
55:["$","p","68",{"className":"mt-5 text-lg leading-[1.75] text-ink","children":"No code handy? Paste your privacy policy, your store listing text, and a description of your stack instead. That covers items 3 through 5 and 14 through 20 on its own, and the answers to the AI's follow-up questions cover most of the rest."}]
