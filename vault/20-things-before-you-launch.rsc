$L8","20-ways-vibecoded-app-hacked",{"href":"/vault/20-ways-vibecoded-app-hacked","className":"post","children":[["$","span",null,{"className":"cover","children":[["$","img",null,{"src":"/covers/20-ways-vibecoded-app-hacked.webp","width":1200,"height":800,"alt":"","loading":"lazy","decoding":"async"}],["$","canvas",null,{"aria-hidden":"true"}]]}],["$","span",null,{"className":"post-meta","children":[["$","b",null,{"children":"Shipping"}],["$","span",null,{"children":"8 min"}]]}],["$","h3",null,{"className":"post-title","children":"20 ways someone hacks your vibecoded app"}],["$","p",null,{"className":"post-excerpt line-clamp-3","children":"The video's list, written out. 20 things someone can do to a live app, each with the real case behind it (Next.js, Tea, Stripe, Verizon, OWASP) and the fix. Plus one prompt that checks your own app for every one and reports before it changes anything."}]]}]]}]]}]
